@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{--bg:#f7f8f6;--surface:#fff;--ink:#18221d;--muted:#77827b;--line:#e5e9e5;--accent:#176f58;--accent-soft:#eaf4ef;--error:#b84d41;--warning:#b6782a;--shadow:0 15px 50px rgba(26,45,36,.04)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.55 'DM Sans',system-ui,sans-serif}button,input{font:inherit}button{cursor:pointer}button:disabled{opacity:.5;cursor:wait}button:focus-visible,input:focus-visible,summary:focus-visible{outline:3px solid #95d8b9;outline-offset:2px}a{color:inherit}h1,h2,h3,h4,p{margin-top:0}.hidden{display:none!important}.layout{min-height:100vh}.topbar{height:79px;background:rgba(255,255,255,.87);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 max(26px,calc((100vw - 1170px)/2));backdrop-filter:blur(14px);position:sticky;top:0;z-index:10}.brand{display:flex;align-items:center;gap:11px;text-decoration:none}.brand-symbol{width:35px;height:35px;border-radius:12px;background:#182b24;color:#fff;display:grid;place-items:center;font:800 18px Manrope,sans-serif}.brand-label{font:800 16px Manrope,sans-serif;letter-spacing:-.6px}.brand-label span{font-weight:500;color:#77847b;margin-left:5px}.nav{display:flex;gap:6px;background:#f3f5f2;padding:5px;border:1px solid #e9eeea;border-radius:13px}.nav button{border:0;border-radius:9px;padding:9px 15px;background:transparent;color:#78847b;font-weight:700;font-size:12px;transition:background .2s,color .2s}.nav button.active{color:#1a2a21;background:#fff;box-shadow:0 2px 9px #162b1b0d}.topright{display:flex;align-items:center;gap:13px}.top-status{display:flex;gap:8px;align-items:center;color:#77847b;font-size:12px}.dot{width:7px;height:7px;background:#b9c1bc;border-radius:50%}.dot.online{background:#2b9c72;box-shadow:0 0 0 4px #2b9c7213}.linkbtn{border:0;background:transparent;color:#65776d;font-size:12px;font-weight:700;padding:8px}.linkbtn:hover{color:#126a50}
main{max-width:1170px;padding:0 26px 90px;margin:0 auto}.section{animation:enter .28s ease both}@keyframes enter{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
/* login gate — entirely separate from authenticated workspace */
.login-wrap{min-height:calc(100vh - 79px);display:grid;place-items:center;padding:60px 15px}.login-shell{max-width:930px;width:100%;display:grid;grid-template-columns:1.05fr 0.95fr;background:white;border:1px solid var(--line);border-radius:25px;box-shadow:0 22px 70px #15271b0a;overflow:hidden}.login-story{background:#e9f0eb;padding:60px 54px;display:flex;flex-direction:column;justify-content:space-between;min-height:460px;position:relative;isolation:isolate;overflow:hidden}.login-story:after{content:"";position:absolute;width:310px;height:310px;border:1px solid #b9ccbf;border-radius:50%;bottom:-125px;right:-100px;box-shadow:0 0 0 36px #d7e6dc,0 0 0 72px #e2ede5;z-index:-1}.kicker{font-size:11px;letter-spacing:.14em;font-weight:800;color:#54826d;text-transform:uppercase}.login-story h1{font:800 clamp(30px,3vw,43px)/1.15 Manrope,sans-serif;letter-spacing:-1.6px;margin:20px 0}.login-story p{color:#657a6e;max-width:330px;line-height:1.8}.login-caption{font-size:12px;color:#688473;font-weight:600}.login-form{padding:58px 48px;display:flex;flex-direction:column;justify-content:center}.login-form h2{font:800 24px Manrope,sans-serif;letter-spacing:-.8px;margin-bottom:8px}.login-form .intro{color:var(--muted);margin-bottom:32px;font-size:13px}.field{display:block;font-size:12px;font-weight:700;color:#485b4e;margin:18px 0 8px}.input{width:100%;border:1px solid #dce5dd;background:#fff;border-radius:11px;padding:13px 14px;outline:none;color:#1b3124;transition:border-color .2s,box-shadow .2s}.input:focus{border-color:#5ea885;box-shadow:0 0 0 3px #60ae8720}.input::placeholder{color:#a5afa7}.btn{border:1px solid #dfe7e0;border-radius:11px;padding:11px 16px;background:#fff;color:#385341;font-weight:700;font-size:13px;display:inline-flex;justify-content:center;align-items:center;gap:9px;transition:transform .18s,border-color .18s,background .18s;white-space:nowrap}.btn:hover{border-color:#b5ceb9;background:#f9fbf9;transform:translateY(-1px)}.btn.primary{background:#176f58;color:white;border-color:#176f58}.btn.primary:hover{background:#105640}.btn.soft{background:var(--accent-soft);border-color:var(--accent-soft);color:#16644e}.btn.small{padding:9px 12px;font-size:12px}.btn.full{width:100%}.notice{font-size:12px;color:#176f58;min-height:20px;margin-top:16px;line-height:1.7}.notice.error{color:#be5044}
/* workspace */
.page-head{padding:61px 0 29px;display:flex;justify-content:space-between;align-items:flex-end;gap:30px}.page-head h1{font:800 clamp(26px,3.2vw,40px)/1.18 Manrope,sans-serif;letter-spacing:-1.6px;margin:11px 0 9px}.page-head p{color:var(--muted);max-width:650px;font-size:14px;line-height:1.8;margin-bottom:0}.actions{display:flex;gap:9px;flex-wrap:wrap}.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:0 0 27px}.kpi{padding:25px 27px;border-radius:17px;background:white;border:1px solid var(--line);box-shadow:var(--shadow);min-height:158px}.kpi-label{font-size:12px;color:#7d8c82;font-weight:700}.kpi-value{font:800 35px Manrope,sans-serif;letter-spacing:-1.2px;margin:13px 0 7px}.kpi-foot{font-size:12px;color:#8a958c}.kpi-value.smallvalue{font-size:23px;margin-top:21px}.panel{background:var(--surface);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);overflow:hidden}.panel-head{padding:24px 28px 19px;display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:1px solid #edf0ed}.panel-head h2{font:800 17px Manrope,sans-serif;letter-spacing:-.45px;margin:0 0 5px}.panel-head p{font-size:12px;color:#8b988d;margin:0}.panel-content{padding:26px 28px}.two-col{display:grid;grid-template-columns:1.15fr .85fr;gap:17px}.hint-box{border-radius:14px;background:#f0f6f1;padding:22px 24px;color:#496c58}.hint-box h3{font:800 14px Manrope,sans-serif;margin-bottom:7px;color:#214d36}.hint-box p{font-size:13px;line-height:1.8;margin:0}.empty{padding:44px 28px;text-align:center;color:#849188}.empty-symbol{width:45px;height:45px;margin:0 auto 13px;background:#ecf4ee;border-radius:50%;display:grid;place-items:center;color:#277456;font-weight:800;font-size:19px}.empty strong{display:block;color:#3c5344;margin-bottom:5px}.incident{border:1px solid #e8eee8;border-radius:12px;padding:19px 20px;margin-bottom:12px}.incident-top{display:flex;justify-content:space-between;gap:10px;align-items:center}.incident strong{font-size:13px}.incident p{margin:11px 0 5px;color:#627467;font-size:13px}.incident ol{padding-left:18px;margin:9px 0 0;color:#6a7c6f;line-height:1.8;font-size:12px}.pill{padding:5px 10px;border-radius:100px;background:#eff6f0;color:#337c58;font-size:11px;font-weight:700}.pill.warn{background:#fff5e6;color:#b77723}.pill.bad{background:#fff0ef;color:#b85449}.guidance{display:grid;gap:14px}.guidance .step{display:flex;gap:14px;align-items:flex-start}.num{width:27px;height:27px;flex-shrink:0;border-radius:9px;background:#eaf4eb;color:#297453;display:grid;place-items:center;font-size:12px;font-weight:800}.step b{display:block;font-size:13px;margin:0 0 3px}.step p{color:#8a958d;font-size:12px;margin:0;line-height:1.7}
/* client lab */
.client-form{display:grid;grid-template-columns:minmax(220px,1fr) auto;align-items:end;gap:13px}.button-row{display:flex;flex-wrap:wrap;gap:9px;margin:18px 0 0}.report{margin-top:24px;border:1px solid #e9ede9;border-radius:14px;overflow:hidden;background:#fcfdfb;max-height:560px;overflow-y:auto}.report-head{padding:12px 17px;color:#6b7d70;font-size:11px;letter-spacing:.11em;font-weight:800;text-transform:uppercase;background:#f2f6f2}.checkrow{display:flex;align-items:flex-start;gap:13px;border-bottom:1px solid var(--line);padding:15px 18px}.checkrow:last-child{border-bottom:0}.checkmark{width:23px;height:23px;display:grid;place-items:center;border-radius:50%;font-weight:800;flex-shrink:0;background:#e3f3e8;color:#248457}.checkmark.fail{background:#fff0ed;color:#bb5147}.checkrow b{display:block;font-size:13px}.checkrow p{color:#87958b;font-size:12px;margin:4px 0 0}.json{white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.6 Consolas,monospace;color:#425a49;padding:15px 18px;margin:0}
