.playbooks-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.playbook{background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden}.playbook summary{cursor:pointer;list-style:none;padding:24px;display:flex;justify-content:space-between;gap:14px;align-items:center}.playbook summary::-webkit-details-marker{display:none}.playbook .topic{display:flex;align-items:center;gap:12px;font-weight:800;font-size:14px}.topic-icon{width:36px;height:36px;flex-shrink:0;background:#edf5ee;border-radius:11px;display:grid;place-items:center;color:#227c55;font-size:17px}.chevron{color:#a0ada2;font-size:19px;transition:transform .2s}.playbook[open] .chevron{transform:rotate(45deg)}.playbook-body{border-top:1px solid var(--line);padding:0 25px 24px;color:#66786b;line-height:1.85;font-size:13px}.playbook-body ol{padding-left:22px;margin:18px 0 0}.playbook-body li{margin-bottom:6px}.playbook-body .safe{background:#f0f5f0;padding:12px 14px;border-radius:9px;margin-top:14px;font-size:12px}
/* help */
.help-index{display:flex;flex-wrap:wrap;gap:9px;margin:21px 0 29px}.help-index a{display:inline-block;background:white;border:1px solid var(--line);border-radius:9px;padding:9px 13px;color:#486052;text-decoration:none;font-size:12px;font-weight:700}.help-index a:hover{border-color:#b0c8b7}.help-block{margin-bottom:20px}.help-block h2{font:800 17px Manrope,sans-serif;margin-bottom:12px;letter-spacing:-.4px}.help-block p,.help-block li{line-height:1.9;color:#64776a;font-size:13px}.help-block ul,.help-block ol{padding-left:20px}.help-table{width:100%;border-collapse:collapse;font-size:13px}.help-table th{text-align:left;color:#829087;font-size:12px;background:#f7faf7}.help-table th,.help-table td{padding:13px 15px;border-bottom:1px solid var(--line);vertical-align:top}.help-table td:first-child{font-weight:700;color:#374e3f;width:35%}.footer{font-size:11px;color:#a0aba1;text-align:center;padding:40px 0 0}
@media(max-width:920px){.topbar{padding:0 18px}.two-col,.login-shell{grid-template-columns:1fr}.login-story{min-height:auto;padding:34px}.login-form{padding:35px}.nav button{padding:9px 11px}.playbooks-list{grid-template-columns:1fr}}@media(max-width:650px){.topbar{height:auto;min-height:76px;flex-wrap:wrap;padding:13px 16px}.brand-label span,.top-status{display:none}.nav{order:3;width:100%;justify-content:space-between}.nav button{flex:1;padding:8px 6px;font-size:11px}main{padding:0 16px 55px}.page-head{padding:38px 0 22px;display:block}.page-head .actions{margin-top:20px}.kpis{grid-template-columns:1fr}.kpi{min-height:auto}.panel-head,.panel-content{padding:19px}.client-form{grid-template-columns:1fr}.button-row .btn{flex:1}.login-wrap{padding:20px 0}.login-story{display:none}}
