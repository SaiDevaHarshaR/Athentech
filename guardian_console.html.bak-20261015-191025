const FIX_RULES = [
 [/\b(latency|slow|lag|sluggish|takes? (?:too )?long|response time|long response|high response time)\b/i,'llm-latency',/\b(llm|ai|model|provider|gpt|claude|chatbot)\b/i],
 [/\b(429|rate.limit|too many requests|quota exceeded|provider outage)\b/i,'llm-rate-limit'],
 [/\b(intent|fallback|routing|uses? the llm|llm instead|token cost|direct report uses ai)\b/i,'intent-routing'],
 [/\b(tat|sla|reptime|tattime|turnaround|compliance)\b/i,'tat-no-sla'],
 [/unexpected token|doctype|html instead of json|json parse/i,'api-html'],
 [/\b(08s01|odbc|database connection|sql connection|sql login failed)\b/i,'sql-connect'],
 [/\b(sql|database|query)\b.*\b(slow|timeout|latency|performance)\b|\b(timeout|slow)\b.*\b(sql|query)\b/i,'slow-sql'],
 [/\b(502|503|bad gateway|service unavailable|backend down)\b/i,'iis-502'],
 [/\b(pdf|playwright|chromium)\b/i,'pdf-export'],
 [/\b(collection|paidamount|totalamount|wrong revenue|cash mismatch)\b/i,'collection-mismatch'],
 [/\b(schema|invalid column|invalid object|missing table|mapping)\b/i,'schema-change']
];
function findFix(input){const q=String(input||'').trim();if(!q)return null;
for(const rule of FIX_RULES){if(rule[0].test(q)&&(!rule[2]||rule[2].test(q)))return FIX_BY_ID[rule[1]];}
const matches=FIXES.filter(f=>f.terms.test(q.toLowerCase()));
return matches.length===1?matches[0]:null;
}
