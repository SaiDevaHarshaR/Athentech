/* Calm interactive guidance */
.loading-screen{position:fixed;inset:0;z-index:70;background:#f7f8f6ed;backdrop-filter:blur(9px);display:grid;place-items:center;animation:enter .2s ease}.loading-card{background:#fff;border:1px solid var(--line);border-radius:22px;box-shadow:0 30px 90px #193c2a19;padding:34px;text-align:center;width:min(390px,90vw)}.loading-orb{width:68px;height:68px;border-radius:50%;background:conic-gradient(from 0deg,#176f58,#82c8a2,#d5f3de,#176f58);margin:0 auto 20px;animation:spin 1.3s linear infinite;display:grid;place-items:center}.loading-orb:after{content:"✳";width:52px;height:52px;border-radius:50%;background:#fff;display:grid;place-items:center;font-size:25px;color:#176f58;animation:counterspin 1.3s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}@keyframes counterspin{to{transform:rotate(-360deg)}}.loading-title{font:800 18px Manrope,sans-serif;margin:0 0 8px}.loading-caption{color:#78877d;font-size:13px}.loading-progress{height:4px;background:#eef4ef;border-radius:4px;overflow:hidden;margin:21px 0 0}.loading-progress:before{content:"";display:block;width:42%;height:100%;background:#176f58;border-radius:4px;animation:slide 1.3s ease-in-out infinite alternate}@keyframes slide{from{transform:translateX(-100%)}to{transform:translateX(245%)}}
.solution-button{margin-top:15px}.solution-panel{margin-top:14px;padding:18px;border:1px solid #d9e9dc;background:#f5faf6;border-radius:14px}.solution-panel h4{font:800 14px Manrope,sans-serif;margin:0 0 9px;color:#235940}.solution-panel p{font-size:12px!important;margin:8px 0!important}.solution-panel ol{font-size:12px;line-height:1.9}.solution-panel .btn{margin-top:9px}.control-explain{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:20px}.control-explain details{border:1px solid var(--line);border-radius:13px;background:#fff;padding:15px 16px}.control-explain summary{cursor:pointer;font-size:12px;font-weight:800;color:#285842}.control-explain p{color:#6c7d70;font-size:12px;line-height:1.7;margin:10px 0 0}.searchbar{display:flex;gap:11px;align-items:center;background:#fff;border:1px solid #dce6dd;border-radius:15px;padding:8px 14px;margin:8px 0 12px;box-shadow:0 4px 18px #183d2610}.searchbar input{width:100%;padding:9px 4px;border:0;outline:0;color:#21382a;background:transparent}.searchbar svg{color:#89a194;flex-shrink:0}.search-help{color:#7c8d80;font-size:12px;margin-bottom:24px}.search-hint{margin-left:auto;white-space:nowrap;color:#4e8368;font-size:11px;font-weight:800}.result-count{font-weight:700;color:#69816f;margin:0 0 15px;font-size:12px}.playbooks-list .playbook[hidden]{display:none}.empty-search{padding:30px;background:#fff;border:1px dashed #dce5de;border-radius:13px;color:#607d68;text-align:center}.safe-note{padding:12px 15px;background:#fff8ec;border:1px solid #f2e5d0;border-radius:12px;font-size:12px;color:#8b6c36;margin-top:12px}.quick-search{width:100%;max-width:530px}.solution-panel li{margin-bottom:4px}@media(max-width:920px){.control-explain{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){.loading-orb,.loading-orb:after,.loading-progress:before{animation:none!important}}

/* Guardian Fix Center — calm, beginner-first */
.fix-center{margin:0 0 24px;background:linear-gradient(130deg,#f5faf6,#fff);border:1px solid #dce9df;border-radius:20px;padding:26px 29px;box-shadow:0 10px 34px #1c45300a}.fix-header{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}.fix-title{font-size:20px;font-weight:800;letter-spacing:-.6px;margin:5px 0 6px}.fix-sub{font-size:13px;line-height:1.7;color:#68806f}.fix-inputs{display:grid;grid-template-columns:1fr auto;gap:12px;margin-top:18px}.fix-inputs input{width:100%;border:1px solid #cfdfd4;border-radius:12px;background:#fff;padding:14px 16px;font:inherit;font-size:13px;outline-color:#3a9763;min-width:0}.fix-picks{display:flex;flex-wrap:wrap;gap:7px;margin-top:14px}.fix-picks button{border:1px solid #d5e4d9;background:#fff;border-radius:999px;font:700 11px inherit;font-size:11px;color:#3f6751;padding:8px 12px;cursor:pointer}.fix-picks button:hover{background:#eaf5ec}.fix-answer{margin-top:18px;border:1px solid #cce1d1;border-radius:15px;padding:20px;background:white}.fix-answer h3{margin:0 0 7px;font-size:17px;color:#234f36}.fix-answer p{color:#62796a;line-height:1.75;font-size:13px}.fix-answer ol{padding-left:21px;margin:13px 0;color:#405f49;font-size:13px;line-height:1.9}.fix-answer .fix-foot{margin-top:15px;display:flex;flex-wrap:wrap;gap:9px;align-items:center}.fix-answer a,.doc-link{display:inline-flex;align-items:center;gap:5px;text-decoration:none;color:#247348;font-weight:800;font-size:12px}.fix-tag{display:inline-block;color:#547860;background:#edf5ef;padding:5px 9px;border-radius:20px;font-size:10px;font-weight:800;margin-bottom:10px}.fix-safety{margin-top:15px;padding:13px;border-radius:10px;background:#fff9ed;color:#806637;font-size:12px;line-height:1.7}.doc-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px;margin:18px 0 26px}.doc-card{display:block;text-decoration:none;background:#fff;border:1px solid #dbe6dd;border-radius:14px;padding:19px 18px;transition:transform .15s,border-color .15s}.doc-card:hover{transform:translateY(-2px);border-color:#85bd94}.doc-card b{display:block;color:#294b36;font-size:13px;margin-bottom:7px}.doc-card span{display:block;color:#718174;font-size:12px;line-height:1.55}.check-help{border-radius:12px;margin:12px 0;padding:16px;background:#f3f8f4;border:1px solid #dcebe0}.check-help h4{margin:0 0 6px;font-size:13px;color:#2a6040}.check-help p{font-size:12px;line-height:1.7;color:#64806b}.fix-foot .btn{font-size:12px}.fix-alert{font-size:12px;color:#986b36;margin:9px 0}.doc-label{font-size:11px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:#57916b}@media(max-width:900px){.doc-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.fix-center{padding:20px}.fix-inputs{grid-template-columns:1fr}.doc-grid{grid-template-columns:1fr}}
</style>
