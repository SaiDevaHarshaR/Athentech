<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <httpErrors errorMode="Detailed" />
        <rewrite>
            <rules>
                <rule name="Guardian FastAPI Proxy" stopProcessing="true">
                    <match url="^admin/guardian/(.*)$" />
                    <action type="Rewrite" url="http://127.0.0.1:8000/admin/guardian/{R:1}" />
                </rule>
            </rules>
        </rewrite>
  </system.webServer>
</configuration>
