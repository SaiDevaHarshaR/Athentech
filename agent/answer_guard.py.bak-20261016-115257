"""Answer guard - the "can I trust this number?" layer around the agent.

  * guard_numbers(): if an answer contains figures that are not in the database results, re-ask ONCE with an exact
    instruction (compute totals in SQL, use only returned numbers). Still unverified -> a visible caution line is added.
  * clarify(): a vague one/two word question ("collection", "revenue") gets one short question + tap-to-answer chips
    instead of a guess. Never fires when a fixed quick report already handles the question, or in a follow-up.
  * Answer cache: identical question, same client + role, no chat history, verified answer -> served for a short time.
  * Progress: friendly "what I'm doing now" labels pushed to a queue (used by /ask/stream).
Never raises into the caller: every public function degrades to "do nothing".
"""
from __future__ import annotations

import contextvars
import os
import re
import threading
import time

ENABLED = os.getenv("SAHASRA_NUMBER_GUARD", "1") != "0"
CLARIFY_ENABLED = os.getenv("SAHASRA_CLARIFY", "1") != "0"
CACHE_TTL = int(os.getenv("SAHASRA_ANSWER_CACHE_SECONDS", "90") or 0)
CACHE_MAX = 400

# ----------------------------------------------------------------------------- progress (for streaming)
PROGRESS = contextvars.ContextVar("sahasra_progress", default=None)
LAST_INFO = contextvars.ContextVar("sahasra_guard_info", default=None)   # {"retried","unverified"} of the current request


def emit(label: str) -> None:
    try:
        q = PROGRESS.get()
        if q is not None and label:
            q.put_nowait(("status", str(label)[:120]))
    except Exception:
        pass


_TOOL_LABELS = {
    "search_schema": "Finding the right tables…",
    "describe_table": "Reading the table layout…",
    "his_describe_table": "Reading the table layout…",
    "run_sql_query": "Querying your database…",
