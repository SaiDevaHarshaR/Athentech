DATEW = _r(r"tarikh", r"tareekh", r"theeyathi", r"thedhi", r"dinank", r"\bdate\b", r"தேதி", r"തീയതി", r"तारीख", r"তারিখ", r"તારીખ", r"ਤਾਰੀਖ", r"ତାରିଖ", r"تاریخ")

def kw_intent2(t):
    t = (t or "").strip()
    if not t or len(t) > 160 or re.search(r"@|\d{4,}|[A-Za-z]{2,}\d{3,}", t) or SKIP.search(t):
        return None
    # patch163
    if TEST.search(t) and MOST.search(t) and not PRICE.search(t) and not PEND.search(t) and not BRANCH.search(t) and not INVOICE.search(t) and not REPORT.search(t) and not re.search(r"(?i)expensive|costly|cheap|price|rate|cost", t):
        return "Which tests were ordered most frequently?"
    if REPORT.search(t) and READYW.search(t) and not PEND.search(t) and not TEST.search(t) and not PAY.search(t):
        return "What is the status of my reports?"
    if AGREE.search(t) and DATEW.search(t) and not DETAIL.search(t) and not re.search(r"(?i)start|from|shuru|suru", t):
        return "When does our agreement expire?"
    if CREDITW.search(t) and LIMITW.search(t) and not PRICE.search(t) and not TEST.search(t) and not PACKAGE.search(t):
        return "What is my credit limit?"
    if BILL2.search(t) and LASTW.search(t) and MONTHW.search(t) and not THREE.search(t) and not INVOICE.search(t) and not UNPAID.search(t) and not (RECENT.search(t) and re.search(r"(?<!\d)10(?!\d)", t)):
        return "How many bills did I get last month?"
    if DUEW.search(t) and MONEYW.search(t) and not TEST.search(t) and not REPORT.search(t) and not RECV.search(t) and not INVOICE.search(t) and not PACKAGE.search(t) and not BILL2.search(t) and not ORDERW.search(t):
        return "What is my outstanding balance?"
    return None

