 "bn": r"\bkoto\b|\bache\b|\bamar\b|amader|hoyeche|\bei mashe|\bgato\b|\bmashe\b|\\bdekhan\\b|korun|tulona|\bbatil|hote pare|shotangsho|somoy|obostha|\bapnara\b|bokeya|koyti|ekhono|samprotik|biboron|chukti|\bhobe\b|peyechen|parben|\bdite\b|biller|sobcheye|beshi",
 "gu": r"\bketla\b|\bketli\b|\bketlu\b|\bketlo\b|\bchhe\b|\bhatu\b|\bthaya\b|\bmara\b|\bmari\b|\bmaru\b|batavo|sarkham|nakaray|\bmoda\b|\btaka\b|tajetar|vigato|kararni|sthiti shu|aavya|\btran\b|sauthi|vadhu|mangavya|\bhaju\b|pachla|chhella|apo cho|\bshako\b|\bsamay ketlo|ketla bills",
 "pa": r"\bkinne\b|\bkinna\b|\bkinni\b|\bkihde\b|\bkihdi|\bvich\b|\bsade\b|\bsadi\b|\bmerian\b|\bradd\b|\bsakde\b|pratishat|mahinean|ikrar|\bvere\b|adaig|\bhaje\b|keemat te|\bdasso\b|\bkado\b|\bsamaan\b|aaian|\bda\b|\bdi\b|\bhan\b",
 "or": r"\bkete\b|achhi|\bebe\b|\bmora\b|\bmo\b|apana|upalabdha|sabuthu|adhika|deiparibe|diaijai|heichi|saribe|\bgata\b|ehi masa|\bmasa re\b|dekhantu|karantu|bilamba|sambhabana|pratisata|pratyakhyat|bibarani|\bkana\b|\bsesh\b|mulya o",
}
_LANGW_X = {'ta': 'evai|mudiyatha|mudiyaadha', 'kn': 'purnagoll|jaasti|yavuvu|aagutte', 'ml': 'eppol|avasaan|poorthiyaakaatha|varunnathu|ethokke|karaar', 'mr': '\\bkadhi\\b|sampto|sampat', 'bn': '\\bdekhan\\b|\\bshesh hoyni|hoyni', 'pa': '\\bkadon\\b|hovega|samjhaut|\\bhale\\b|\\bhoe\\b|pure nahi', 'or': '\\bkebe\\b|\\bhebe\\b|\\bsesha\\b', 'gu': '\\bkyare\\b'}   # patch159
for _k, _v in {'ta': r'\badhigam\b|\bpanra\b|\bpona\b|mottham|\bethana\b|pottirukk|kidaikk|serndh|vandhu', 'kn': r'galive|talup|\bhana\b|nimage', 'ml': r'labhyam|packagukal|cheyyappedunna', 'bn': r'pouch|\bjoma\b|\bkache\b', 'gu': r'thashe|\bmali gai\b|\bbhareli\b|\btamne\b', 'pa': r'mildey|\bmiyad\b|\bkado tak\b|\bhon wala\b', 'or': r'milila|\btanka\b|apananku|heuthiba|karithiba|\bkeunti\b'}.items():   # patch161
    _LANGW_X[_k] = _LANGW_X.get(_k, '') + '|' + _v
for _k, _v in {'ta': r'\bentha\b|\binnum\b|varala|varavillai|kidaich|kidaitha', 'ml': r'ithuvare|vannittilla|kittiyo', 'bn': r'\btaka\b|diyechi|peyechi|peyeche', 'pa': r'\basin\b|tuhanu|\bditte\b'}.items():   # patch160
    _LANGW_X[_k] = _LANGW_X.get(_k, '') + '|' + _v
for _k, _v in {'ta': r'arikkai|thayaar|parisothan|varaadha|mudivu|seyyapp|\bedhu\b', 'ml': r'theeyathi|vareyaan|aalukal|cheyyunna', 'mr': r'\bhote\b|\bjast\b|miltat|\bkonte\b|ahaval', 'or': r'\bkeun\b|\bhebe\b|shesha|tarikhare|masare|asinahin|eyaan|\bpurba\b|keteta|katagala|\bhelani\b|parikshara'}.items():   # patch163
    _LANGW_X[_k] = _LANGW_X.get(_k, '') + '|' + _v
_LANGW["te"] = r'\bentha\b|\bmaa\b|\bmaaku\b|\bmemu\b|\bmanam\b|\benni\b|\bemiti\b|\benti\b|\bela\b|\bekkada\b|\bevaru\b|unnayi|unnara|\bundi\b|\bunnam\b|\bledu\b|cheppandi|chupinchandi|ivvandi|\bkavali\b|\bmee\b|\bmeeru\b|\bnaa\b|ayyayi|\bayindi\b|\bayyinda\b|\bekkuva\b|ekkuvaga|\binka\b|pampina|chellinchina|\bandinda\b|\bpadinda\b|mugustundi|avutundi|\bgata\b nela|\bnelalo\b|billulu|\bdaggara\b|\bpoina\b|\bvesaru\b|\braani\b|\bdabbu\b|\bichina\b'   # patch167
_LANGW_X['ta'] = _LANGW_X.get('ta', '') + '|adhigama|pannirukk|thedhiyil|mudigir|aaguthu|\boppandham\b'   # patch167
_LANGW['te'] += r'|\bento\b|\bee\b|\bnela\b|\bayyaya\b|\bayyaa\b'   # patch168
_LANGW = {k: re.compile(v + (('|' + _LANGW_X[k]) if k in _LANGW_X else ''), re.I) for k, v in _LANGW.items()}

def guess_lang(t):
    """Language code of a question typed in English letters, from distinctive words; None when unclear or tied."""
    sc = sorted(((len(rx.findall(t or "")), k) for k, rx in _LANGW.items()), reverse=True)
    if not sc or sc[0][0] == 0:
        return None
    if len(sc) > 1 and sc[1][0] == sc[0][0]:
        return None
    return sc[0][1]

_UR = re.compile(r"\bhamen\b|raqam|karwayi|zimme|guzishta|\bhad di\b|teston|\bkin teston|dikhayen|mustarad|tafseel|muahid|muazna|qeemat|feesad|sharah|mahinon|adaigi|\btayyar\b|\bki had\b", re.I)   # patch168: hamara/hamare/hamari are Hindi too
_HI = re.compile(r"\bkitn[aei]\b|\bmer[aei]\b|\bhain?\b|\bkya\b|\bkaun\b|\bkab\b|dikha|\bmujhe\b|\baap\b|\bpichle\b|\bbakaya\b|aapko|\bmil gaya\b|\bhui\b", re.I)

def guess_hindustani(t):
    """'ur' for typical Urdu words, 'hi' for general Hindi/Urdu words, None when it does not look like Hindi/Urdu at all."""
    if _UR.search(t or ""):
        return "ur"
    if _HI.search(t or ""):
        return "hi"
    return None

def guess_roman(t, allow_hi=True):
    """Language code for a question in English letters: Urdu-only words first, then the 8 other languages, then general Hindi/Urdu."""
    if _UR.search(t or ""):
        return "ur"
    g = guess_lang(t)
    if g:
        return g
    if re.search(r'(?i)\bentha\s*\??\s*$', t or ''):   # patch168: 'entha' at the end = how much (Telugu)
        return 'te'
    h = guess_hindustani(t)
    return h if (h and (allow_hi or h != "hi")) else None


def kw_intent(t):   # patch162
    return kw_intent_a(t) or kw_intent2(t)
