def kw_intent(t):
    """Return the exact English question for t, or None."""
    t = (t or "").strip()
    if not t or len(t) > 160 or re.search(r"@|\d{4,}|[A-Za-z]{2,}\d{3,}", t) or SKIP.search(t):
        return None
    if STMT.search(t) and BILLING.search(t):
        return "Can you provide the monthly billing statement?"
    if AGREE.search(t) and END.search(t):
        return "When does our agreement expire?"
    if INVOICE.search(t) and UNPAID.search(t) and not COPY.search(t):
        return "Which invoices are unpaid?"
    if INVOICE.search(t) and COMPARE.search(t) and THREE.search(t):
        return "Compare our last three months' invoices."
    if BRANCH.search(t) and MOST.search(t):
        return "Which branch has the highest test volume?"
    if TEST.search(t) and MOST.search(t) and ORDER.search(t):
        return "Which tests were ordered most frequently?"
    if ORDERW.search(t) and DELAY.search(t):
        return "Which orders are likely to be delayed?"
    if SAMPLE.search(t) and REJ.search(t):
        return "What is our sample rejection percentage?" if PCT.search(t) else "Show rejected samples"
    if BILL.search(t) and RECENT.search(t) and re.search(r"(?<!\d)10(?!\d)", t):
        return "Top 10 recent bills"
    if AGREE.search(t) and DETAIL.search(t):
        return "Contract agreement details"
    if PAY.search(t) and STATUSW.search(t) and not PEND.search(t):
        return "Payment status"
    if CBC.search(t) and TIMEW.search(t) and PRICE.search(t):
        return "What is the price and report time for CBC?"
    if REPORT.search(t) and (PEND.search(t) or PEND2.search(t)) and not TEST.search(t):
        return "Which of my reports are pending?"
    if REPORT.search(t) and STATUSW.search(t) and not PEND.search(t) and not PAY.search(t):
        return "What is the status of my reports?"
    if TEST.search(t) and PEND.search(t) and not INVOICE.search(t) and not PACKAGE.search(t):
        return "Which tests are still pending?"
    if PACKAGE.search(t) and AVAIL.search(t) and not PRICE.search(t):
        return "What health-check packages are available?"
    return None

