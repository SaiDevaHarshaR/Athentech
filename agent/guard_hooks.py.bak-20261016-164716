"""One-line hook for main.py:   from agent.guard_hooks import install; install(app)

Everything "trust + speed" and "scheduled reports" is attached here at STARTUP, after main.py has registered all its routes,
so main.py itself needs only that single line (no fragile edits inside /ask):
  * /ask  gets: vague-question clarification, a short verified-answer cache, ops counters, and the number guard
    (figures not found in the database results -> re-ask once -> visible caution line)
  * /ask/stream  live progress (server-sent events) - the widget falls back to /ask if it is unavailable
  * Guardian API: regression tests, recent alerts
  * Admin API: scheduled reports        * background scheduler (alerts, scheduled reports)
Every piece is wrapped so a problem in one never stops the app from starting. Off switch: SAHASRA_GUARD_HOOKS=0
"""
import json
import os
import sys
import threading

_done = False


def _log(msg):
    try:
        print("[guard-hooks] " + msg, flush=True)
    except Exception:
        pass


def install(app):
    if os.getenv("SAHASRA_GUARD_HOOKS", "1") == "0":
        return
    try:
        from agent import hardening
        hardening.install(app)
    except Exception as e:
        _log("hardening skipped: %s" % type(e).__name__)
    hooked = False
    for attach in (lambda: app.add_event_handler("startup", lambda: _late_install(app)),
                   lambda: app.router.on_startup.append(lambda: _late_install(app))):
        try:
            attach()
            hooked = True
            break
        except Exception:
            continue
    # safety net for FastAPI/Starlette versions that ignore startup handlers (lifespan apps): run once shortly after import
    t = threading.Timer(4.0, lambda: _late_install(app))
    t.daemon = True
    t.start()


def _find_route(app, path, method):
    for r in app.router.routes:
        if getattr(r, "path", None) == path and method in (getattr(r, "methods", None) or ()):
            return r
    return None


def _guard_ask_agent(fn):
    """ask_agent(**kw) -> same result, plus the number guard for premium (client-data) answers."""
    if getattr(fn, "_sahasra_guarded", False):
        return fn
    from agent import answer_guard as ag, confidence as conf

    def guarded(*a, **kw):
        try:        # a worker thread is reused across hospitals: never carry one hospital's table columns into the next request
            from agent.tools import reset_request_schema_cache
            reset_request_schema_cache()
        except Exception:
            pass
        ans, tok = fn(*a, **kw)
        try:
            ag.LAST_INFO.set({"unverified": []})
            if kw.get("is_premium") and "question" in kw:
                def again(q):
                    k2 = dict(kw)
                    k2["question"] = q
                    return fn(*a, **k2)
                ans, tok, info = ag.guard_numbers(again, kw["question"], ans, tok, conf)
                ag.LAST_INFO.set(info)
        except Exception as e:
            _log("number guard skipped: %s" % type(e).__name__)
        try:        # privacy: phone numbers masked unless the role needs them; patient lookups are audited
            from agent import privacy as pv
            if kw.get("is_premium"):
                pv.audit_lookup(kw.get("institution_code"), kw.get("role"), kw.get("question"))
                if isinstance(ans, str):
                    ans = pv.mask_for_role(ans, kw.get("role"))
        except Exception as e:
            _log("privacy step skipped: %s" % type(e).__name__)
        return ans, tok
    guarded._sahasra_guarded = True
    guarded.__wrapped__ = fn
    return guarded


def _late_install(app):
    global _done
    if _done:
        return
    _done = True
    _runtime_patches()
    ask_route = _find_route(app, "/ask", "POST")
    orig = None
    if ask_route is not None:
        try:
            orig = ask_route.endpoint
            g = orig.__globals__
            if "ask_agent" in g:
                g["ask_agent"] = _guard_ask_agent(g["ask_agent"])
            _wrap_ask(app, ask_route, orig)
        except Exception as e:
            _log("/ask wrapper not installed: %s" % type(e).__name__)
    else:
        _log("/ask route not found - guard/cache/stream skipped")

    for name, fn in (("regression + alerts API", _admin_api), ("scheduled reports API", _reports_api), ("scheduler", _scheduler)):
        try:
            fn(app)
        except Exception as e:
            _log("%s not installed: %s %s" % (name, type(e).__name__, e))


# ----------------------------------------------------------------------------- runtime patches (no edits inside your other files)
def _runtime_patches():
    """Adds the small hooks the guard needs to confidence / heal / ops_lite while the app runs, so none of those files
    has to be edited (they differ per server). Each one is skipped silently-but-logged if the target is not as expected."""
    try:       # confidence.unverified(): figures in an LLM answer that are not in the database results
        from agent import confidence as c
        if not hasattr(c, "unverified"):
            def unverified():
                try:
                    h = c._h()
                    if h is None or h.kind != "llm" or not h.ok:
                        return []
                    pool = []
                    for r in h.ok:
                        pool += c._numbers(r)
                    qn = set(c._numbers(h.question))
                    return [v for v in c._numbers(h.answer) if v not in qn and not c._grounded(v, pool)]
                except Exception:
                    return []
            c.unverified = unverified
        if hasattr(c, "note_tool_call") and not getattr(c.note_tool_call, "_sg", False):
            _orig = c.note_tool_call

            def note_tool_call(*a, **k):
                try:
                    from agent import answer_guard as _ag
                    _ag.tool_progress(a[0] if a else "", a[1] if len(a) > 1 else None)
                except Exception:
                    pass
                return _orig(*a, **k)
            note_tool_call._sg = True
            c.note_tool_call = note_tool_call
    except Exception as e:
        _log("confidence hooks skipped: %s" % type(e).__name__)
    try:       # natural wording that had no quick report went to the slow AI path (many steps, sometimes wrong): route it to the fixed reports
        from agent import intents as it
        more = {
            "_handle_authenticated_count": ["reports were authenticated", "reports are authenticated", "reports authenticated", "authenticated reports", "how many authenticated",
                                            "authenticated yesterday", "authenticated this week", "authenticated last week", "authenticated this month", "authenticated last month",
                                            "reports got authenticated", "reports have been authenticated", "number of authenticated"],
            "_handle_bills_count": ["number of bills", "bills count", "bills generated", "bills made", "bills created", "bills raised", "total bills"],
            "_handle_patients_count": ["new patient", "patient registrations", "patients registered", "registered patients", "patients registered"],
            "_handle_all_collection": ["how much did we collect", "how much we collected", "how much have we collected"],
            "_handle_mode_only": ["how much cash", "cash collection", "cash collected", "upi collection", "how much upi", "card collection", "cheque collection"],
            "_handle_concession_total": ["total discount", "how much discount", "discount given", "concession total", "concession given", "discount total"],
            "_handle_refunds": ["how much was refunded", "refund amount", "total refund", "refunds total", "amount refunded"],
            "_handle_due_payments": ["how much due", "due collected", "due received", "total due payments", "due payments received"],
            "_handle_cancelled_tests": ["tests were cancelled", "cancelled tests", "number of cancelled", "tests cancelled", "tests got cancelled"],
        }
        done = set()
        for kws, handler in it._INTENTS:
            names = getattr(handler, "__name__", "")
            if names in more and names not in done:
                done.add(names)
                for w in more[names]:
                    if w not in kws:
                        kws.append(w)
        # a quick report for ALL branches must not answer "...in Uppal": if the question names one of this hospital's branches, let the AI apply the filter
        import re as _re
        _generic = {"main", "lab", "labs", "central", "centre", "center", "branch", "office", "total", "unit", "collection", "city", "town", "road"}

        def _names_branch(q, db_name, db_server, db_user, db_password):
            try:
                from agent.schema_ctx import location_names
                if _re.search(r"\b(branch|branches|centre|center|location|unit|outlet)\b", q):
                    return True
                for n in location_names(db_name, db_server, db_user, db_password) or []:
                    n = str(n).lower().strip()
                    if len(n) >= 4 and n not in _generic and _re.search(r"(?<![a-z0-9])" + _re.escape(n) + r"(?![a-z0-9])", q):
                        return True
            except Exception:
                pass
            return False

        def _branch_safe(h):
            if getattr(h, "_sg_branch", False):
                return h

            def w(q, role, db_name, db_server=None, db_user=None, db_password=None, matched_keyword=None):
                if _names_branch(q, db_name, db_server, db_user, db_password):
                    return None
                return h(q, role, db_name, db_server, db_user, db_password, matched_keyword=matched_keyword)
            w.__name__ = h.__name__
            w._sg_branch = True
            return w
        for _i, (_kws, _h) in enumerate(list(it._INTENTS)):
            if getattr(_h, "__name__", "") in more:
                it._INTENTS[_i] = (_kws, _branch_safe(_h))
    except Exception as e:
        _log("quick-report routing skipped: %s" % type(e).__name__)
    try:       # shared Groq was never built: the chain calls _build_llm(api_key=...) but _build_llm() takes no argument
        import inspect
        import agent.agent as ag3
        if "api_key" not in inspect.signature(ag3._build_llm).parameters:
            _bl0 = ag3._build_llm

            def _build_llm(api_key=None):
                if not api_key:
                    return _bl0()
                from langchain_groq import ChatGroq
                return ChatGroq(model=getattr(ag3.settings, "llm_model", None) or "openai/gpt-oss-20b", temperature=0, api_key=api_key)
            ag3._build_llm = _build_llm
            _log("shared Groq key can now be used")
    except Exception as e:
        _log("groq build fix skipped: %s" % type(e).__name__)
    try:       # say WHY a provider failed (status + message), not just the error class - keys are masked
        import sys as _sys
        import agent.agent as ag4
        if not getattr(ag4, "_sg_print", False):
            import builtins

            def _print(*a, **k):
                try:
                    msg = " ".join(str(x) for x in a)
                    if "[_invoke_with_retry]" in msg and "failed:" in msg:
                        err = _sys.exc_info()[1]
                        if err is not None:
                            code = getattr(err, "status_code", None) or getattr(getattr(err, "response", None), "status_code", None)
                            body = str(getattr(err, "body", None) or err)[:300].replace("\n", " ")
                            try:
                                from agent.hardening import redact
                                body = redact(body)
                            except Exception:
                                pass
                            a = (msg + " | status=%s %s" % (code, body),)
                except Exception:
                    pass
                return builtins.print(*a, **k)
            ag4.print = _print
            ag4._sg_print = True
    except Exception as e:
        _log("provider error detail skipped: %s" % type(e).__name__)
    try:       # figures the assistant worked out itself (totals, differences, averages, lakh/crore) are not "missing" - accept exact derivations
        from agent import confidence as c2
        if not getattr(c2._grounded, "_sg", False):
            _g0 = c2._grounded

            def _grounded2(v, pool):
                if _g0(v, pool):
                    return True
                try:
                    P = []
                    for p in pool:
                        if p not in P:
                            P.append(p)
                    P = P[:120]
                    if not P:
                        return False
                    ok = lambda x: abs(x - v) <= 0.51
                    for sc in (1e3, 1e5, 1e7):             # shown as K / lakh / crore
                        for p in P:
                            if p and abs(p / sc - v) <= max(0.051, abs(p / sc) * 0.005):
                                return True
                    tot = sum(P)
                    if ok(tot) or ok(tot / len(P)):
                        return True
                    for k in range(2, min(len(P), 12) + 1):  # sum / average of the first k values (a "top k" list)
                        sm = sum(P[:k])
                        if ok(sm) or ok(sm / k):
                            return True
                    for i, a1 in enumerate(P):
                        for b1 in P[i + 1:]:
                            if ok(a1 + b1) or ok(abs(a1 - b1)):
                                return True
                except Exception:
                    return False
                return False
            _grounded2._sg = True
            c2._grounded = _grounded2
    except Exception as e:
        _log("derived-figure check skipped: %s" % type(e).__name__)
    try:       # Heal approve/revert: clear cached answers; an approved fix becomes a saved regression test
        from agent import heal as h
        if hasattr(h, "decide") and not getattr(h.decide, "_sg", False):
            _d = h.decide

            def decide(*a, **k):
                try:       # refuse to approve a fix that fails the plain-language safety checks
                    pid0 = a[0] if a else k.get("pid")
                    act0 = a[1] if len(a) > 1 else k.get("action")
                    if act0 == "approve" and os.getenv("SAHASRA_HEAL_ENFORCE", "1") != "0":
                        from agent.heal_verdict import verdict
                        v = verdict(h.get_proposal(pid0))
                        if v["level"] == "block":
                            why = " ".join(c["text"] for c in v["checks"] if c["status"] == "block")
                            return {"error": "Not approved - " + why[:400] + " Reject it, or ask AthenTech support."}
                except Exception:
                    pass
                res = _d(*a, **k)
                try:
                    pid = a[0] if a else k.get("pid")
                    action = a[1] if len(a) > 1 else k.get("action")
                    if isinstance(res, dict) and not res.get("error"):
                        _audit(k.get("actor") or (a[2] if len(a) > 2 else "admin"), "Heal fix %s" % action, "proposal #%s (%s)" % (pid, (res.get("client") or "")))
                    if action in ("approve", "revert"):
                        from agent import answer_guard, regression
                        answer_guard.cache_clear(None)
                        if action == "approve":
                            p = h.get_proposal(pid) or {}
                            regression.add_case(p.get("client"), (p.get("before_json") or {}).get("question"), int(pid))
                except Exception:
                    pass
                return res
            decide._sg = True
            h.decide = decide
    except Exception as e:
        _log("heal hook skipped: %s" % type(e).__name__)
    try:       # Heal preview: remember whether the 'After' answer contains numbers that are not in the database results
        from agent import heal as h, agent as ag_mod, confidence as c2
        import contextvars
        PV = contextvars.ContextVar("sg_preview_unverified", default=None)
        if hasattr(ag_mod, "ask_agent") and not getattr(ag_mod.ask_agent, "_sg", False):
            _aa = ag_mod.ask_agent

            def ask_agent(*a, **k):
                try:
                    if h.PREVIEW.get() and hasattr(c2, "begin"):
                        c2.begin(k.get("question") or (a[0] if a else ""))     # fresh tracking for the preview question
                except Exception:
                    pass
                res = _aa(*a, **k)
                try:
                    if h.PREVIEW.get() and hasattr(c2, "unverified"):
                        PV.set([float(v) for v in c2.unverified()][:8])
                except Exception:
                    pass
                return res
            ask_agent._sg = True
            ag_mod.ask_agent = ask_agent
        if hasattr(h, "create_proposal") and not getattr(h.create_proposal, "_sg", False):
            _cp = h.create_proposal

            def create_proposal(*a, **k):
                PV.set(None)
                res = _cp(*a, **k)
                try:
                    un = PV.get()
                    if un is not None and isinstance(res, dict) and res.get("id") and not res.get("error"):
                        import json as _j
                        after = dict(res.get("after_json") or {})
                        after["unverified"] = un
                        conf = res.get("confidence")
                        if un and isinstance(conf, (int, float)):
                            conf = min(int(conf), 40)
                        with h._LOCK:
                            cx = h._conn()
                            try:
                                cx.execute("UPDATE heal_proposals SET after_json=?, confidence=? WHERE id=?",
                                           (_j.dumps(after), conf, int(res["id"])))
                                cx.commit()
                            finally:
                                cx.close()
                        res = h.get_proposal(res["id"]) or res
                except Exception:
                    pass
                return res
            create_proposal._sg = True
            h.create_proposal = create_proposal
    except Exception as e:
        _log("heal preview check skipped: %s" % type(e).__name__)
    try:       # B2B login codes over WhatsApp (Pinnacle) when B2B_OTP_PROVIDER=pinnacle
        from auth import b2b_otp_pinnacle
        if b2b_otp_pinnacle.install():
            _log("B2B login codes are sent through Pinnacle WhatsApp")
    except Exception as e:
        _log("pinnacle B2B otp skipped: %s" % type(e).__name__)
    try:       # ops counters used by the new events
        from observability import ops_lite as o
        extra = {"guardrail", "ask", "report_pdf", "report_excel", "scheduled_report", "regression", "alert"}
        if hasattr(o, "_ALLOWED_EVENTS"):
            o._ALLOWED_EVENTS = frozenset(set(o._ALLOWED_EVENTS) | extra)
    except Exception as e:
        _log("ops hook skipped: %s" % type(e).__name__)
    try:       # strict guardrails: code-level checks on every question and every answer
        from agent import guard_strict as gs
        from agent import guardrails as g
        import agent.agent as ag
        if not getattr(g.check_input, "_strict", False):
            _oi, _oo = g.check_input, g.check_output

            def check_input(text):
                ok, msg = _oi(text)
                if not ok:
                    _ops("guardrail", "denied")
                    _refused(text, "blocked pattern")
                    return ok, msg
                ok, msg = gs.screen_input(text)
                if not ok:
                    _ops("guardrail", "denied")
                    _refused(text, msg[:60])
                    _log("blocked question: %r" % (str(text)[:80],))
                return ok, msg

            def check_output(text):
                return gs.screen_output(_oo(text))
            check_input._strict = check_output._strict = True
            g.check_input, g.check_output = check_input, check_output
            ag.check_input, ag.check_output = check_input, check_output
            _log("strict guardrails on")
            try:   # latency: tighter, tunable limits on the tool loop (env SAHASRA_LLM_BUDGET / SAHASRA_MAX_ROUNDS)
                import os as _os
                # accuracy first: limits stay at the app's own values unless you set these on purpose
                if _os.getenv("SAHASRA_LLM_BUDGET"):
