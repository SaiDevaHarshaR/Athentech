# ----------------------------------------------------------------------------- Guardian: regression + alerts
def _admin_api(app):
    from fastapi import Depends, HTTPException
    from auth.admin_auth import require_admin

    def reg_list(client: str = "", admin: str = Depends(require_admin)):
        from agent import regression
        return {"status": "success", "rows": regression.list_cases(client or None)}

    def reg_run(client: str = "", admin: str = Depends(require_admin)):
        from agent import regression
        res = regression.run_all(client or None)
        if res.get("error"):
            return {"status": "error", "message": res["error"]}
        return {"status": "success", **res}

    def reg_case(case_id: int, action: str, admin: str = Depends(require_admin)):
        from agent import regression
        if action == "delete":
            regression.delete_case(case_id)
        elif action in ("enable", "disable"):
            regression.set_enabled(case_id, action == "enable")
        else:
            raise HTTPException(status_code=404, detail="Unknown action.")
        return {"status": "success"}

    def alerts_list(admin: str = Depends(require_admin)):
        from observability import alerts
        return {"status": "success", "alerts": alerts.recent()}

    def heal_verdict(pid: int, admin: str = Depends(require_admin)):
        from agent import heal
        from agent.heal_verdict import verdict
        p = heal.get_proposal(pid)
        if not p:
            raise HTTPException(status_code=404, detail="Proposal not found.")
        return {"status": "success", "verdict": verdict(p)}

    def proof(answer_id: int, admin: str = Depends(require_admin)):
        """Re-runs the answer's logged read-only queries and returns the raw rows - the evidence behind the numbers."""
        from agent import heal
        row = heal._answer_row(answer_id)
        if not row:
            raise HTTPException(status_code=404, detail="Answer not found.")
        creds = heal._client_creds(row["client"])
        if not creds:
            return {"status": "error", "message": "Client connection details are unavailable."}
        out = []
        for q in [q for q in (row.get("sql_json") or []) if heal.safe_select(q)][:3]:
            r = heal._run_readonly(creds, q)
            out.append({"sql": q[:700], "ok": r.get("ok"), "cols": r.get("cols"), "rows": r.get("rows"), "error": r.get("error")})
        return {"status": "success", "question": row.get("question"), "queries": out}

    def readiness_get(admin: str = Depends(require_admin)):
        from auth import readiness
        return {"status": "success", **readiness.summary()}

    def readiness_run(client: str = "", admin: str = Depends(require_admin)):
        from auth import readiness
        started = readiness.start(client or None)
        return {"status": "success", "started": started}

    # ---- accuracy checks / usage insights / backups (auth/admin_extras.py)
    from fastapi import Body
    from fastapi.responses import Response

    def acc_get(admin: str = Depends(require_admin)):
        from auth import admin_extras as x
        return {"status": "success", "config": x.get_cfg(), "regression": x.last_run("regression"), "consistency": x.last_run("consistency"),
                "running": {"regression": x.STATE["regression"]["running"], **x.STATE["consistency"]}}

    def acc_put(body: dict = Body(...), admin: str = Depends(require_admin)):
        from auth import admin_extras as x
        try:
            cfg = x.set_cfg(body)
        except ValueError as e:
            raise HTTPException(status_code=400, detail=str(e))
        _audit(admin, "Changed accuracy-check settings", "nightly=%s at %s" % (cfg["nightly_enabled"], cfg["nightly_time"]))
        return {"status": "success", "config": cfg}

    def acc_run(admin: str = Depends(require_admin)):
        from auth import admin_extras as x
        _audit(admin, "Started accuracy check", "all clients")
        return {"status": "success", "started": x.run_regression_bg(None, notify=False)}

    def acc_cons(body: dict = Body(...), admin: str = Depends(require_admin)):
        from auth import admin_extras as x
        c = str(body.get("client") or "").strip()
        if not c:
            raise HTTPException(status_code=400, detail="Choose a client.")
        _audit(admin, "Started consistency check", c)
        return {"status": "success", "started": x.run_consistency_bg(c, body.get("n", 8), body.get("k", 3))}

    def usage_get(days: int = 30, admin: str = Depends(require_admin)):
        from auth import admin_extras as x
        return {"status": "success", **x.usage_insights(max(1, min(int(days), 365)))}

    def bk_list(admin: str = Depends(require_admin)):
        from auth import admin_extras as x
        return {"status": "success", "backups": x.list_backups(), "config": x.get_cfg()}

    def bk_make(admin: str = Depends(require_admin)):
        from auth import admin_extras as x
        n = x.make_backup("manual")
        _audit(admin, "Created settings backup", n)
        return {"status": "success", "name": n}

    def bk_dl(name: str, admin: str = Depends(require_admin)):
        from auth import admin_extras as x
        try:
            data = x.backup_bytes(name)
        except ValueError as e:
            raise HTTPException(status_code=404, detail=str(e))
        return Response(data, media_type="application/zip", headers={"Content-Disposition": 'attachment; filename="%s"' % name})

    def bk_restore(name: str, body: dict = Body(default={}), admin: str = Depends(require_admin)):
        from auth import admin_extras as x
        if str(body.get("confirm") or "") != "RESTORE":
            raise HTTPException(status_code=400, detail="Type RESTORE to confirm.")
        try:
            done = x.restore(name, str(admin))
        except ValueError as e:
            raise HTTPException(status_code=404, detail=str(e))
        _audit(admin, "Restored settings backup", name)
        return {"status": "success", "restored": done}

    def bank_get(admin: str = Depends(require_admin)):
        from agent import accuracy_bank as ab
        return {"status": "success", **ab.results()}

    def bank_run(body: dict = Body(default={}), admin: str = Depends(require_admin)):
        from agent import accuracy_bank as ab
        c = str((body or {}).get("client") or "").strip() or None
        _audit(admin, "Started accuracy test", c or "all clients")
        if not ab.run_bg(c):
            raise HTTPException(status_code=409, detail="An accuracy test is already running.")
        return {"status": "success", "started": True}

    def priv_get(admin: str = Depends(require_admin)):
        from agent import privacy
        return {"status": "success", **privacy.overview()}

    def priv_put(body: dict = Body(...), admin: str = Depends(require_admin)):
        from agent import privacy
        try:
            cfg = privacy.set_cfg(body)
        except (ValueError, TypeError) as e:
            raise HTTPException(status_code=400, detail=str(e))
        _audit(admin, "Changed privacy settings", json.dumps(cfg))
        return {"status": "success", "config": cfg}

    def priv_purge(admin: str = Depends(require_admin)):
        from agent import privacy
        r = privacy.purge(True)
        _audit(admin, "Ran data clean-up", json.dumps(r))
        return {"status": "success", "deleted": r}

    app.add_api_route("/admin/privacy", priv_get, methods=["GET"])
    app.add_api_route("/admin/privacy", priv_put, methods=["PUT"])
    app.add_api_route("/admin/privacy/purge", priv_purge, methods=["POST"])
    app.add_api_route("/admin/accuracy/bank", bank_get, methods=["GET"])
    app.add_api_route("/admin/accuracy/bank/run", bank_run, methods=["POST"])
    app.add_api_route("/admin/accuracy", acc_get, methods=["GET"])
    app.add_api_route("/admin/accuracy", acc_put, methods=["PUT"])
    app.add_api_route("/admin/accuracy/run", acc_run, methods=["POST"])
    app.add_api_route("/admin/accuracy/consistency", acc_cons, methods=["POST"])
    app.add_api_route("/admin/usage-insights", usage_get, methods=["GET"])
    app.add_api_route("/admin/backups", bk_list, methods=["GET"])
    app.add_api_route("/admin/backups", bk_make, methods=["POST"])
    app.add_api_route("/admin/backups/{name}/download", bk_dl, methods=["GET"])
    app.add_api_route("/admin/backups/{name}/restore", bk_restore, methods=["POST"])

    app.add_api_route("/admin/readiness", readiness_get, methods=["GET"])
    app.add_api_route("/admin/readiness/run", readiness_run, methods=["POST"])
    app.add_api_route("/admin/guardian/api/heal-verdict/{pid}", heal_verdict, methods=["GET"])
    app.add_api_route("/admin/guardian/api/proof/{answer_id}", proof, methods=["GET"])
    app.add_api_route("/admin/guardian/api/regression", reg_list, methods=["GET"])
    app.add_api_route("/admin/guardian/api/regression/run", reg_run, methods=["POST"])
    app.add_api_route("/admin/guardian/api/regression/{case_id}/{action}", reg_case, methods=["POST"])
    app.add_api_route("/admin/guardian/api/alerts", alerts_list, methods=["GET"])


