def _wrap_ask(app, route, orig):
    from fastapi import Request
    from fastapi.responses import StreamingResponse
    from agent import answer_guard as ag
    QueryRequest = orig.__annotations__.get("req") or orig.__globals__["QueryRequest"]

    def ask_wrapped(req: QueryRequest, request: Request):      # sync: FastAPI runs it in the worker pool, like the original
        from agent import followup as fu
        code = (getattr(req, "activation_code", None) or "").strip().upper()
        question = req.question or ""
        hist = len(getattr(req, "chat_history", None) or [])
        ping = question.strip().lower() in ("validate", "athentech mode", "about athentech", "about-us")
        understood = None
        if code and not ping:
            try:        # Telugu / Hindi / Telglish -> English words the assistant understands
                from agent import lang_bridge as lb
                tq, changed = lb.translate(question)
                if changed:
                    understood, question = tq, tq
                    req.question = tq
            except Exception:
                pass
        if code and not ping and hist >= 2:
            try:        # "and last month?" -> "collection last month"
                rw = fu.rewrite(question, getattr(req, "chat_history", None))
                if rw and rw != question:
                    understood, question = rw, rw
                    req.question = rw
            except Exception:
                pass
        if code and not ping and hist and fu.is_standalone(question):
            try:        # context relevance: a self-contained question gets no old turns (less noise, faster)
                req.chat_history = []
                hist = 0
            except Exception:
                pass
        if code and not ping:
            cl = ag.clarify(question, hist)
            if cl:
                return {"status": "success", "answer": cl["answer"], "mode": "premium", "suggestions": cl["suggestions"], "clarify": True}
            hit = ag.cache_get(code, "-", question, hist)
            if hit:
                hit["cached"] = True
                return hit
        ag.LAST_INFO.set({"unverified": []})
        try:
            res = orig(req, request)
        except Exception as e:
            _ops("ask", "failure")
            try:
                from fastapi import HTTPException as _HE
                if isinstance(e, _HE) and e.status_code < 500:
                    raise
            except ImportError:
                pass
            msg, ref = fu.friendly_error(repr(e))
            _log("ask error ref %s: %s" % (ref, repr(e)[:300]))
            return {"status": "error", "answer": msg}
        try:
            conf = (res or {}).get("confidence") or {}
            _ops("ask", "success" if (not conf or conf.get("ok")) else "denied")
            try:
                from agent.agent import _BYOK_USER_MESSAGES
                if res.get("answer") in _BYOK_USER_MESSAGES.values():
                    _ops("ai_provider", "failure")
            except Exception:
                pass
            # --- polish: friendly errors, no table names, plain explain, contextual chips, "understood as"
            if isinstance(res, dict):
                ans = res.get("answer") or ""
                if fu.looks_technical(ans) or (res.get("status") == "error" and fu.looks_technical(str(res.get("message") or ""))):
                    msg, ref = fu.friendly_error(ans or res.get("message"))
                    _log("ask answer replaced, ref %s: %s" % (ref, ans[:300]))
                    res["answer"], res["status"] = msg, "error"
                elif res.get("mode") == "premium":
                    res["answer"] = fu.sanitize_answer(ans)
                    _pm = fu.period_mismatch(question, res["answer"])
                    if _pm and "Please verify" not in res["answer"]:
                        res["answer"] += "\n\n_" + _pm + "_"
                    if res.get("explain"):
                        res["explain"] = fu.plain_explain(res["explain"], bool(conf.get("ok", True)))
                    ctx = fu.contextual(question)
                    if ctx and isinstance(res.get("suggestions"), list):
                        res["suggestions"] = (ctx + [x for x in res["suggestions"] if x not in ctx])[:3]
                if understood:
                    res["understood_as"] = understood
            if (code and not ping and res.get("status") == "success" and res.get("mode") == "premium" and conf.get("ok")
                    and not (ag.LAST_INFO.get() or {}).get("unverified") and res.get("answer_id")):
                ag.cache_put(code, "-", question, res, hist)
        except Exception:
            pass
        return res

    # swap the route's handler: remove the original, register the wrapper at the same path
    app.router.routes[:] = [r for r in app.router.routes if r is not route]
    app.add_api_route("/ask", ask_wrapped, methods=["POST"])

    async def ask_stream(req: QueryRequest, request: Request):
        import asyncio
        import json as _json
        import queue as _queue
        q = _queue.Queue()

        def _sse(kind, data):
            return "event: %s\ndata: %s\n\n" % (kind, _json.dumps(data, default=str))

        def _work():
            ag.PROGRESS.set(q)
            try:
                return ask_wrapped(req, request)
            except Exception:
                return {"status": "error", "answer": "Something went wrong while answering. Please try again."}

        async def _gen():
            loop = asyncio.get_running_loop()
            fut = loop.run_in_executor(None, _work)
            yield _sse("status", "Understanding your question…")
            idle = 0.0
            while not fut.done():
                try:
                    kind, val = q.get_nowait()
                    idle = 0.0
                    yield _sse(kind, val)
                except _queue.Empty:
                    await asyncio.sleep(0.15)
                    idle += 0.15
                    if idle >= 10:
                        idle = 0.0
                        yield ": ping\n\n"
            res = await fut
            yield _sse("done", res)

        return StreamingResponse(_gen(), media_type="text/event-stream",
                                 headers={"Cache-Control": "no-cache", "X-Accel-Buffering": "no", "Connection": "keep-alive"})
    app.add_api_route("/ask/stream", ask_stream, methods=["POST"])
    _log("/ask wrapped (clarify, cache, number guard, ops) and /ask/stream added")


def _audit(admin, action, target=""):
    """Writes to the same audit log the Audit Logs screen reads (event 'admin_action')."""
    try:
        from audit.log import audit
        audit(event="admin_action", role=None, code=None, question="%s: %s" % (action, target),
              meta={"actor": str(admin), "action": action, "target": str(target)})
