# OFF BY DEFAULT. Hosted Hugging Face is already a per-institution BYOK provider.
# Institution staff enter their own HF token in Sahasra's AI Provider settings.
# Choose a chat-completions compatible model available to the HF account.
SAHASRA_HF_HOSTED_MODEL=

# OPTIONAL future private inference service; not deployed at Stage 6.
SAHASRA_HF_PRIVATE_ENABLED=0
SAHASRA_HF_PRIVATE_BASE_URL=https://inference.internal.example/v1
SAHASRA_HF_PRIVATE_ALLOWED_HOSTS=inference.internal.example
SAHASRA_HF_PRIVATE_MODEL=
# Never put HF tokens or other secrets in this sample. No API token fallback.
