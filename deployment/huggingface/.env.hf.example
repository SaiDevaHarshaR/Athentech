# TEMPLATE ONLY; do not enter real keys in version control.
# Hosted mode: each institution sets their HF token inside existing BYOK UI.
SAHASRA_HF_HOSTED_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Local mode is disabled by default. Requires operator to approve ONE institution.
SAHASRA_HF_LOCAL_ENABLED=0
SAHASRA_HF_LOCAL_CLIENT_PREFIX=YOUR_TEST_INSTITUTION_PREFIX
SAHASRA_HF_LOCAL_BASE_URL=http://hf-local:8000/v1
SAHASRA_HF_LOCAL_MODEL=YOUR_APPROVED_MODEL_ID
# The local institution's BYOK key must match the gateway key (NOT committed here).
SAHASRA_HF_LOCAL_GATEWAY_KEY=REPLACE_PRIVATELY
HF_TOKEN=REPLACE_PRIVATELY
VLLM_IMAGE_TAG=PIN_AND_VERIFY_SUPPORTED_RELEASE
