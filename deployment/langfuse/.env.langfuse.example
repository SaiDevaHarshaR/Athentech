# SAHASRA API configuration only (do not publish actual values)
SAHASRA_LANGFUSE_ENABLED=0
LANGFUSE_PUBLIC_KEY=REPLACE_WITH_LANGFUSE_PROJECT_PUBLIC_KEY
LANGFUSE_SECRET_KEY=REPLACE_WITH_LANGFUSE_PROJECT_SECRET_KEY
# Set to reachable INTERNAL Langfuse URL; if on same Compose network: http://langfuse-web:3000
LANGFUSE_BASE_URL=http://langfuse-web:3000
LANGFUSE_TRACING_ENVIRONMENT=staging
# Never enable generic auto instrumentation, full payload recording, or automatic prompt capture.
