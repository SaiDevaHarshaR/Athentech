# Disabled until Stage 7A is reviewed and staged.
SAHASRA_RAG_ENABLED=0
# Private, persistent host-mounted directory. Never put inside IIS static wwwroot.
SAHASRA_RAG_STORE=/var/lib/sahasra/rag
# Optional: offline pre-approved Hugging Face model path (not needed for Stage 7A retrieval).
SAHASRA_RAG_HF_MODEL_PATH=
