# Configuration template ONLY. No paid cloud services or tokens required to prepare source.
SAHASRA_ENV=staging
SAHASRA_LANGFUSE_ENABLED=0
SAHASRA_METRICS_ENABLED=0
# Offline B2B intent routing needs no AI provider/API key.
B2B_INTENT_ENGINE=local_deterministic
# Future optional local models -- keep disabled until machine capacity checked.
SAHASRA_LOCAL_LLM_ENABLED=0
# DO NOT enable test OTP on public production. Configure real WhatsApp later.
B2B_TEST_OTP_ENABLED=0
# External SQL and existing ENCRYPTION_KEY injected privately at deployment.
