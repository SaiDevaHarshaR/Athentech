{
  "id": null,
  "uid": "sahasra-command-light",
  "title": "Sahasra • Corporate Light Operations",
  "tags": [
    "sahasra",
    "athentech",
    "prometheus",
    "stage4",
    "light"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(sahasra_http_requests_total{job=\"sahasra-api\"}[$__rate_interval]))",
          "legendFormat": "{{route}} {{operation}} {{format}} {{provider}} {{result}}",
          "refId": "A",
          "range": true,
          "editorMode": "code"
        }
      ],
      "description": "Requests per second for instrumented API calls",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "5xx server error ratio",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(sahasra_http_requests_total{job=\"sahasra-api\",status_class=\"5xx\"}[$__rate_interval])) / clamp_min(sum(rate(sahasra_http_requests_total{job=\"sahasra-api\"}[$__rate_interval])), 0.000001)",
          "legendFormat": "{{route}} {{operation}} {{format}} {{provider}} {{result}}",
          "refId": "A",
          "range": true,
          "editorMode": "code"
        }
      ],
      "description": "HTTP 5xx fraction; zero is meaningful only with traffic",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "API P95 latency",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
