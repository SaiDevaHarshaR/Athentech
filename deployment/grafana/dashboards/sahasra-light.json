        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sahasra_http_request_seconds_bucket{job=\"sahasra-api\"}[$__rate_interval])))",
          "legendFormat": "{{route}} {{operation}} {{format}} {{provider}} {{result}}",
          "refId": "A",
          "range": true,
          "editorMode": "code"
        }
      ],
      "description": "P95 API server duration (not full browser render time)",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
