# =========================================================================
# Sahasra AI Agent — PRODUCTION .env template
# Copy this to .env in the project root and fill in every __FILL_IN__.
# Never commit the real .env to git.
# =========================================================================

# ----- LLM (Groq / OpenAI / Anthropic) -----
GROQ_API_KEY=__FILL_IN__
TAVILY_API_KEY=__FILL_IN__

# Leave LLM_PROVIDER=groq to keep using Groq (no other fields below needed).
# Set to openai or anthropic to switch — LLM_MODEL becomes required if so.
LLM_PROVIDER=groq
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ----- MSSQL: shared server credentials -----
# db_name itself is resolved PER-INSTITUTION at runtime from the license
# record (see auth/license_service.py) — these are just the server-level
# login the app uses to connect, same login across all hospital databases
# on this server.
MSSQL_SERVER=__FILL_IN__
# e.g. sql01.athentech.internal,1433 — ASK THE IT ADMIN

MSSQL_DATABASE=__FILL_IN__
# fallback/default only, real requests use the institution's own db_name

MSSQL_USER=__FILL_IN__
MSSQL_PASSWORD=__FILL_IN__

# ----- Admin auth bootstrap -----
# Run: python auth/generate_admin_hash.py
# It prints the 3 lines below — paste its output here, don't type these by hand.
ADMIN_USERNAME=__FILL_IN__
ADMIN_PASSWORD_HASH=__FILL_IN__
ADMIN_SECRET_KEY=__FILL_IN__

# ----- CORS: which origins can call this API -----
# Must include the real production domain(s) for both the chat widget
# and the admin panel once IIS assigns them. Comma-separated, no spaces.
ALLOWED_ORIGINS=__FILL_IN__
# e.g. https://ai.athentech.in,https://athentech.in,https://admin.athentech.in
# ASK THE IT ADMIN what domain(s) will actually front this
