<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sahasra AI Agent — IIS reverse-proxy config for the API.

  This goes in the IIS site root that will act as the public-facing
  API domain (e.g. https://ai.athentech.in). It forwards every request
  to the Python process running locally via uvicorn.

  PREREQUISITES (one-time, done in IIS Manager, not in this file):
  1. Install "Application Request Routing" (ARR) — download from
     Microsoft's IIS site if not already present.
  2. Install the "URL Rewrite" module — same source.
  3. In IIS Manager, click the SERVER node (not a site) → "Application
     Request Routing Cache" → "Server Proxy Settings" → check
     "Enable proxy". This is a server-level setting and can't be set
     from this file — someone has to click it once in IIS Manager.

  FILL IN: replace __API_PORT__ below with the port uvicorn is actually
  running on (must match what's in the NSSM service install script —
  see install_service.ps1). 8000 is the project's usual default.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="SahasraAIReverseProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:__API_PORT__/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Streaming responses (PDF generation) need this raised from IIS's
         small default buffer, or large PDFs can get truncated. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
        <!-- 50 MB — adjust if Smart Reports end up larger than that -->
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
