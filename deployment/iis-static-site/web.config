<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sahasra AI Agent — IIS config for the STATIC files site.

  This site just serves plain files (admin/index.html, admin/app.js,
  sahasra_chat_widget.html) — no Python involved here at all. IIS
  handles static files natively, this config just makes sure .json and
  a couple of other extensions serve with the right content-type
  (IIS sometimes blocks unrecognized extensions by default).

  Point this site's physical path at the project folder (or wherever
  you copy admin/ and sahasra_chat_widget.html to on the server).
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <httpErrors errorMode="Detailed" />
  </system.webServer>
</configuration>
