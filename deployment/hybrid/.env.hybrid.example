# Source-only Stage 12 settings. All features disabled by default.
# Configure as Windows service environment variables, not public JS.
SAHASRA_HYBRID_ROUTING_ENABLED=0
SAHASRA_HYBRID_COMPLEX_CLOUD_ENABLED=0
SAHASRA_B2B_LOCAL_INTENT_ENABLED=0
SAHASRA_B2B_RAG_ENABLED=0
SAHASRA_B2C_RAG_ENABLED=0
# Local provider (existing Stage 8): explicit per-institution allowlist
SAHASRA_OLLAMA_ENABLED=0
SAHASRA_OLLAMA_ALLOWED_INSTITUTIONS=
SAHASRA_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Private offline approved-document index, not a client LIS folder
SAHASRA_RAG_STORE=
