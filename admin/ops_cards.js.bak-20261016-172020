        var tot = keys.reduce(function (a, k) { return a + ((cl[k] || {}).passed || 0); }, 0), wr = keys.reduce(function (a, k) { return a + ((cl[k] || {}).failed || 0); }, 0);
        badge.textContent = (tot + wr) ? Math.round(100 * tot / (tot + wr)) + '%' : 'Test';
        clearTimeout(timer); if (run.running) timer = setTimeout(load, 5000);
      }).catch(function (e) { msg(body, e.message, 1); });
    }
    load();
  }

