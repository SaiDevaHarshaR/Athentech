# TEMPLATE ONLY. Copy to .env.docker, fill it privately; NEVER commit .env.docker.
# Docker Compose injects these into the container; the app's config.py reads them.
# External AthenTech admin/license SQL Server database:
ADMIN_DB_SERVER=REPLACE_WITH_REACHABLE_SQL_HOST_OR_IP
ADMIN_DB_PORT=1433
ADMIN_DB_NAME=REPLACE_WITH_ADMIN_DATABASE_NAME
ADMIN_DB_USER=REPLACE_WITH_ADMIN_DB_LOGIN
ADMIN_DB_PASSWORD=REPLACE_WITH_ADMIN_DB_PASSWORD

# External institution/LIS SQL Server: fallback values used by config.py.
# Prefer client-specific DB settings stored in AthenTech's admin DB.
# Important: Docker cannot assume your Windows SQL Server's private IP is reachable.
MSSQL_SERVER=REPLACE_WITH_REACHABLE_LIS_HOST_OR_IP,1433
MSSQL_DATABASE=REPLACE_WITH_LIS_DATABASE_NAME
MSSQL_USER=REPLACE_WITH_READ_ONLY_LIS_USER
MSSQL_PASSWORD=REPLACE_WITH_LIS_PASSWORD

# This is a required config.py setting on the uploaded source branch.
# Keep it populated only with an authorized key. Existing institution BYOK rules
# and opt-in fallback are application-level logic; Compose must not override them.
GROQ_API_KEY=REPLACE_WITH_EXISTING_AUTHORIZED_GROQ_KEY
TAVILY_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=

# Keep the SAME encryption key as the running AthenTech environment or previously
# encrypted institution DB credentials / AI keys will not decrypt.
ENCRYPTION_KEY=REPLACE_WITH_EXISTING_ENCRYPTION_KEY
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=REPLACE_WITH_EXISTING_ADMIN_PASSWORD_HASH
ADMIN_SECRET_KEY=REPLACE_WITH_EXISTING_ADMIN_SESSION_SECRET

# Set to the exact origins already approved for this service.
ALLOWED_ORIGINS=https://sahasraaiagent.athentech.in

# Copy existing configured values as relevant, preserving previous application logic.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# B2B_OTP_PROVIDER=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# SAHASRA_ENV=production

# Do NOT turn on B2B_TEST_OTP_ENABLED in production.

# Stage 3: disabled by default. To enable for staging only, generate a
# random >=32-character token. Never put it in logs or source control.
SAHASRA_METRICS_ENABLED=0
SAHASRA_METRICS_TOKEN=
