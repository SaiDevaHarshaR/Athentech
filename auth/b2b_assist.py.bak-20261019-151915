def _terms(q: str):
    t = re.sub(r"[?!.:;()]", " ", q.lower())
    t = re.sub(r"\b(is|are) (the )?(test|tests)\b", " ", t)
    parts = re.split(r",|/|&|\band\b|\bor\b|\bplus\b", t)
    out = []
    for p in parts:
        words = [w for w in p.split() if w not in _STOP and len(w) > 1]
        s = " ".join(words).strip()
        if s and s not in out:
            out.append(s)
    return out[:4]


def _rate_txt(lo, hi):
    """Rates are stored per branch: one price, or a range when branches differ."""
    if lo is None:
        return "No agreed rate on file"
    try:
        lo, hi = float(lo), float(hi if hi is not None else lo)
    except Exception:
        return "No agreed rate on file"
    return _inr(lo) if abs(hi - lo) < 0.005 else "%s - %s (varies by branch)" % (_inr(lo), _inr(hi))


_PKG = "CAST(i.ISPACKAGE AS VARCHAR(8)) IN ('Y','y','1','True','true','YES')"


def _tat(tat, ttype, rep, rtype):
    for v, ty in ((tat, ttype), (rep, rtype)):
        v = str(v or "").strip()
        if v and v not in ("0", "0.0"):
            return (v + " " + str(ty or "").strip()).strip()
    return "Not specified"


def _find_tests(Q, org, term, limit=3):
    like = "%" + term.replace("%", "").replace("[", "") + "%"
    return Q("SELECT TOP %d i.INVCODE, i.INVNAME, i.SAMPLETYPE, i.TATTIME, i.TATTYPE, i.REPTIME, i.REPTIMETYPE, i.PATIENTPROCEDURE, i.IsFasting, "
             "i.OUTSOURCEID, i.ISPACKAGE, rr.lo, rr.hi FROM mstInvestigations i "
             "OUTER APPLY (SELECT MIN(r.RATE) AS lo, MAX(r.RATE) AS hi FROM mstOrgInvestigationRates r WHERE r.INVCODE = i.INVCODE COLLATE DATABASE_DEFAULT AND r.ORGCODE = ? AND r.ACTIVE = 1) rr "
             "WHERE i.ACTIVE = 1 AND (i.INVNAME LIKE ? OR i.ShortName LIKE ? OR i.INVCODE = ?) "
             "ORDER BY CASE WHEN i.INVNAME LIKE ? THEN 0 ELSE 1 END, LEN(i.INVNAME)" % limit,
             (org, like, like, term.upper(), term + "%"))


def _test_answer(Q, org, q, intent):
    terms = _terms(q)
    if not terms:
        return _out("test_enquiry", "Which test do you mean? For example: \"Is CBC available?\", \"Test code for HbA1c\", \"Is fasting required for lipid profile?\"")
    rows, missing = [], []
    for t in terms:
        found = _find_tests(Q, org, t)
        if not found:
            missing.append(t)
        rows += found
    if not rows:
        if re.search(r"\b(urgent|emergency|priority|prioriti[sz]e|home|pickup|appointment|camp|api|portal|login|password|integration|hl7|fhir|accredit|nabl|working hours|timing)\b", q):
            return None          # a service / support question, not a test name: the AI answers from the client's knowledge
        return _out("test_enquiry", "I could not find \"%s\" in the test list. Please check the spelling or give the test code." % ", ".join(missing))
    want_price = bool(re.search(r"\b(price|rate|cost|charge|how much|agreed)\b", q))
    table_rows = []
    seen = set()
    for code, name, stype, tat, tty, rep, rty, prep, fast, outs, ispkg, lo, hi in rows:
        if code in seen:
            continue
        seen.add(code)
        prep_txt = ("Fasting required" if fast in (1, True) else "No fasting") + (" - " + re.sub(r"\s+", " ", str(prep))[:90] if prep and str(prep).strip() else "")
        proc = "Outsourced" if (outs not in (None, "", 0, "0")) else "In-house"
        price = _rate_txt(lo, hi)
        table_rows.append([name, code, stype or "-", _tat(tat, tty, rep, rty), prep_txt, proc, price])
    head = "Yes, " + ("these are" if len(table_rows) > 1 else "this is") + " available." if intent == "avail" else "Here are the details."
    ans = head + (" Your agreed price is shown where one is on file." if want_price else "")
    if missing:
        ans += " I could not find: %s." % ", ".join(missing)
    return _out("test_enquiry", ans, _tbl("Test details", ["Test", "Code", "Sample", "Report time", "Preparation", "Processing", "Your price"], table_rows))


def _package_contents(Q, org, q):
    terms = [t for t in _terms(re.sub(r"\b(profile|package|panel|included|include|includes|contains?|inside|components?|parameters?|investigations?)\b", " ", q.lower()))]
    if not terms:
        return _out("package_contents", "Which profile or package? For example: \"What is included in the full body checkup package?\"")
    like = "%" + terms[0] + "%"
    pk = Q("SELECT TOP 3 INVCODE, INVNAME FROM mstInvestigations WHERE ACTIVE = 1 AND CAST(ISPACKAGE AS VARCHAR(8)) IN ('Y','y','1','True','true','YES') AND (INVNAME LIKE ? OR ShortName LIKE ?) ORDER BY LEN(INVNAME)", (like, like))
    if not pk:
        pk = Q("SELECT TOP 3 INVCODE, INVNAME FROM mstInvestigations WHERE ACTIVE = 1 AND (INVNAME LIKE ? OR ShortName LIKE ?) ORDER BY LEN(INVNAME)", (like, like))
    if not pk:
        return _out("package_contents", "I could not find a profile or package matching \"%s\"." % terms[0])
    code, name = pk[0][0], pk[0][1]
    tests = Q("SELECT DISTINCT i.INVNAME FROM mstInvPackages p JOIN mstInvestigations i ON i.INVCODE COLLATE DATABASE_DEFAULT = p.TESTCODE COLLATE DATABASE_DEFAULT "
              "WHERE p.PACKAGECODE COLLATE DATABASE_DEFAULT = ? AND p.ACTIVE = 1 AND (p.ORGCODE = ? OR p.ORGCODE IS NULL OR p.ORGCODE = '') ORDER BY i.INVNAME", (code, org))
    if not tests:
        tests = Q("SELECT DISTINCT i.INVNAME FROM mstInvPackages p JOIN mstInvestigations i ON i.INVCODE COLLATE DATABASE_DEFAULT = p.TESTCODE COLLATE DATABASE_DEFAULT "
                  "WHERE p.PACKAGECODE COLLATE DATABASE_DEFAULT = ? AND p.ACTIVE = 1 ORDER BY i.INVNAME", (code,))
    if not tests:
        return _out("package_contents", "**%s** (%s) is in the list, but I could not read its included tests." % (name, code))
    rate = Q("SELECT MIN(RATE), MAX(RATE) FROM mstOrgInvestigationRates WHERE ORGCODE = ? AND INVCODE = ? AND ACTIVE = 1", (org, code))
    price = (" Your agreed price: **%s**." % _rate_txt(rate[0][0], rate[0][1])) if rate and rate[0][0] is not None else ""
    return _out("package_contents", "**%s** (%s) includes %d tests.%s" % (name, code, len(tests), price),
                _tbl("Included tests", ["#", "Test"], [[i + 1, r[0]] for i, r in enumerate(tests[:60])]))


def _package_list(Q, org):
    rows = Q("SELECT TOP 15 i.INVNAME, i.INVCODE, rr.lo, rr.hi FROM mstInvestigations i "
             "OUTER APPLY (SELECT MIN(r.RATE) AS lo, MAX(r.RATE) AS hi FROM mstOrgInvestigationRates r WHERE r.INVCODE = i.INVCODE COLLATE DATABASE_DEFAULT AND r.ORGCODE = ? AND r.ACTIVE = 1) rr "
             "WHERE i.ACTIVE = 1 AND " + _PKG + " AND rr.lo IS NOT NULL ORDER BY i.INVNAME", (org,))
    if not rows:
        rows = Q("SELECT TOP 15 i.INVNAME, i.INVCODE, NULL, NULL FROM mstInvestigations i WHERE i.ACTIVE = 1 AND " + _PKG + " ORDER BY i.INVNAME", ())
        note = "Standard packages (no organisation-specific rate list found)."
    else:
        note = "Packages on your rate list."
    if not rows:
        return _out("packages", "I could not find any packages.")
    return _out("packages", note + " Ask \"what is included in <package name>\" for the tests inside.",
                _tbl("Health-check packages", ["Package", "Code", "Your price"], [[r[0], r[1], _rate_txt(r[2], r[3]) if r[2] is not None else "-"] for r in rows]))


# ----------------------------------------------------------------------------------------------- account / billing
def _outstanding(Q, org):
    r = Q("SELECT TOP 1 BalAmt, PayDate FROM trnCompPayments WHERE ORGCODE = ? AND Active = 1 ORDER BY PayDate DESC, CompPayID DESC", (org,))
    return (float(r[0][0] or 0), r[0][1]) if r else (None, None)


def _account_answer(Q, org, q, p):
    if re.search(r"\bcredit (limit|period)|available credit|credit available|credit is available|how much credit|credit days\b", q):
        o = Q("SELECT TOP 1 ISCREDIT, CREDITLIMIT, CREDITPERIOD, GRACEPERIOD, BILLINGCYCLE FROM mstOrganisation WHERE ORGANISATIONCODE = ?", (org,))
        if not o:
            return _out("credit", "I could not read your credit terms.")
        iscr, lim, per, grace, cyc = o[0]
        bal, _ = _outstanding(Q, org)
        rows = [["Credit account", "Yes" if iscr in (1, True) else "No"], ["Credit limit", _inr(lim)], ["Credit period", per or "-"], ["Grace period (days)", grace if grace is not None else "-"]]
        ans = "Your credit limit is **%s**." % _inr(lim)
        if bal is not None:
            avail = float(lim or 0) - bal
            rows += [["Current outstanding", _inr(bal)], ["Available credit", _inr(avail)]]
            ans += " Outstanding **%s**, so about **%s** is available (limit minus outstanding)." % (_inr(bal), _inr(avail))
        return _out("credit", ans, _tbl("Credit terms", ["Item", "Value"], rows))
    if re.search(r"\btds\b", q):
        a, b = _dates(p)
        r = Q("SELECT SUM(TDS), COUNT(*) FROM trnCompPayments WHERE ORGCODE = ? AND Active = 1 AND PayDate >= ? AND PayDate < ?", (org, a, b))
        return _out("tds", "TDS recorded on your payments %s: **%s**." % (_label(p), _inr(r[0][0] if r else 0)))
    if re.search(r"\b(credit note|debit note|credit adjustment|cancelled bill|removed bill|deleted bill)s?\b", q):
        a, b = _dates(p if re.search(r"today|yesterday|month|week|20\d\d", q) else "last_month")
        rows = Q("SELECT TOP 15 DELETEDATE, BILLNO, RATE, REASON FROM trnDelCreditBill WHERE ORGCODE = ? AND DELETEDATE >= ? AND DELETEDATE < ? ORDER BY DELETEDATE DESC",
                 (org, (date.today() - timedelta(days=90)).isoformat() if not re.search(r"today|yesterday|month|week|20\d\d", q) else a, b if re.search(r"today|yesterday|month|week|20\d\d", q) else (date.today() + timedelta(days=1)).isoformat()))
        if not rows:
            return _out("credit_notes", "No credit adjustments (removed credit bills) found for your account in that period.")
        return _out("credit_notes", "Credit adjustments on your account (tests/bills removed from credit):",
                    _tbl("Credit adjustments", ["Date", "Bill", "Amount", "Reason"], [[_d(r[0]), r[1], _inr(r[2]), r[3] or ""] for r in rows]))
    if re.search(r"\b(statement|reconcil|ledger|account summary|invoices? generated|invoice history|billing statement)\b", q):
        inv = Q("SELECT TOP 12 INVOICENO, INVOICENODT, FromDate, ToDate, TotAmt, PaidAmt, DueAmt FROM trnInvoiceGeneration WHERE ORGCODE = ? ORDER BY INVOICENODT DESC", (org,))
        pay = Q("SELECT TOP 8 PayDate, PaidAmt, Mode, TDS, Concession FROM trnCompPayments WHERE ORGCODE = ? AND Active = 1 ORDER BY PayDate DESC, CompPayID DESC", (org,))
        bal, _ = _outstanding(Q, org)
        ans = "Your account statement" + (": current outstanding **%s**." % _inr(bal) if bal is not None else ".")
        t1 = _tbl("Invoices generated", ["Invoice", "Date", "Period", "Amount", "Paid", "Due"],
                  [[r[0], _d(r[1]), "%s to %s" % (_d(r[2]), _d(r[3])), _inr(r[4]), _inr(r[5]), _inr(r[6])] for r in inv]) if inv else None
        t2 = _tbl("Recent payments", ["Date", "Paid", "Mode", "TDS", "Concession"], [[_d(r[0]), _inr(r[1]), r[2] or "", _inr(r[3]), _inr(r[4])] for r in pay]) if pay else None
        out = _out("statement", ans, t1 or t2, suggestions=["Request invoice copy"])
        if t1 and t2:
            out["table2"] = t2
        return out
    if re.search(r"\b(payment|paid|received|receipt)\b", q) and not re.search(r"\b(due|outstanding|pending amount)\b", q):
        pay = Q("SELECT TOP 6 PayDate, PaidAmt, Mode, TDS, Concession, BalAmt FROM trnCompPayments WHERE ORGCODE = ? AND Active = 1 ORDER BY PayDate DESC, CompPayID DESC", (org,))
        if not pay:
            return _out("payments", "I could not find any payments recorded on your account.")
        last = pay[0]
        return _out("payments", "Your last payment recorded was **%s** on **%s** (%s). Balance after it: **%s**." % (_inr(last[1]), _d(last[0]), last[2] or "mode not recorded", _inr(last[5])),
                    _tbl("Recent payments", ["Date", "Paid", "Mode", "TDS", "Concession", "Balance after"], [[_d(r[0]), _inr(r[1]), r[2] or "", _inr(r[3]), _inr(r[4]), _inr(r[5])] for r in pay]))
    bal, at = _outstanding(Q, org)
    if bal is None:
        return _out("outstanding", "I could not find a balance record for your account.")
    return _out("outstanding", "Your outstanding balance is **%s** (as of the last ledger entry on %s)." % (_inr(bal), _d(at)), suggestions=["Payment status", "Billing statement"])


def _contract(Q, org):
    o = Q("SELECT TOP 1 ORGANISATIONNAME, ORGANISATIONCODE, STARTDATE, ENDDATE, ACTIVE, ISCREDIT, CREDITPERIOD, BILLINGCYCLE, GRADE, GRADEPERCENTAGE, CONTACTPERSON "
          "FROM mstOrganisation WHERE ORGANISATIONCODE = ?", (org,))
    if not o:
        return _out("contract", "I could not read your account details.")
    n, code, s, e, act, iscr, per, cyc, gr, grp, cp = o[0]
    rows = [["Client code", code], ["Name", n], ["Account status", "Active" if act in (1, True) else "Inactive"], ["Agreement from", _d(s) or "-"],
            ["Agreement valid till", _d(e) or "-"], ["Credit account", "Yes" if iscr in (1, True) else "No"], ["Credit period", per or "-"],
            ["Billing cycle (days)", cyc if cyc is not None else "-"], ["Grade / discount %", ("%s %s" % (gr or "", ("(" + str(grp) + "%)") if grp else "")).strip() or "-"],
            ["Contact person", cp or "-"]]
    exp = ""
    try:
        if e and str(e)[:10] < date.today().isoformat():
            exp = " Your agreement end date has passed - I can raise a renewal request."
    except Exception:
        pass
    return _out("contract", "Your client code is **%s**. Agreement valid till **%s**.%s" % (code, _d(e) or "not specified", exp), _tbl("Account & agreement", ["Item", "Value"], rows),
                suggestions=["Raise renewal request"] if exp else None)


# ----------------------------------------------------------------------------------------------- tests / reports / samples
def _owned(Q, org, bill):
    return bool(Q("SELECT TOP 1 1 FROM trnINVLABPRI WHERE BILLNO = ? AND ORGANISATIONCODE = ?", (bill, org)))


def _status_for_bill(Q, org, bill):
    if not _owned(Q, org, bill):
        return _out("status", "I could not find bill **%s** on your account." % bill)
    rows = Q("SELECT TOP 40 ISNULL(m.INVNAME, s.TCODE), s.STATUS, s.SAMPLECOLLECTEDDATE, s.ACKNOWLEDGEDDATE, s.RESULTENTRYDATE, s.AUTHENTICATEDATE "
             "FROM trnInvStatus s LEFT JOIN mstInvestigations m ON m.INVCODE COLLATE DATABASE_DEFAULT = s.TCODE COLLATE DATABASE_DEFAULT WHERE s.BILLNO = ? ORDER BY s.ID", (bill,))
    if not rows:
        return _out("status", "No test status has been recorded yet for bill **%s**." % bill)
    done = sum(1 for r in rows if str(r[1] or "").lower().startswith("authent"))
    ans = "Bill **%s**: %d of %d tests have final (authenticated) reports." % (bill, done, len(rows))
    return _out("status", ans, _tbl("Test status", ["Test", "Status", "Sample collected", "Received at lab", "Result entered", "Report authenticated"],
                                    [[r[0], r[1] or "", _d(r[2]), _d(r[3]), _d(r[4]), _d(r[5])] for r in rows]))


def _status_for_period(Q, org, p):
    a, b = _dates(p)
    rows = Q("SELECT ISNULL(s.STATUS,'Not specified'), COUNT(*) FROM trnInvStatus s JOIN trnINVLABPRI p ON p.BILLNO = s.BILLNO "
             "WHERE p.ORGANISATIONCODE = ? AND p.BILLDATE >= ? AND p.BILLDATE < ? GROUP BY ISNULL(s.STATUS,'Not specified') ORDER BY COUNT(*) DESC", (org, a, b))
    if not rows:
        return _out("status", "No tests found for your organisation %s." % _label(p))
    tot = sum(int(r[1]) for r in rows)
    done = sum(int(r[1]) for r in rows if str(r[0]).lower().startswith("authent"))
    return _out("status", "Tests for %s: **%d** total, **%d** with final reports, **%d** in other stages." % (_label(p), tot, done, tot - done),
                _tbl("Tests by stage", ["Stage", "Tests"], [[r[0], r[1]] for r in rows]), suggestions=None)


def _tests_volume(Q, org, p):
    a, b = _dates(p)
    r = Q("SELECT COUNT(*), COUNT(DISTINCT d.BILLNO) FROM trnINVLABDET d JOIN trnINVLABPRI p ON p.BILLNO = d.BILLNO WHERE p.ORGANISATIONCODE = ? AND p.BILLDATE >= ? AND p.BILLDATE < ?", (org, a, b))
    return _out("mis", "Your organisation had **%s tests** across **%s bills** %s." % (format(int(r[0][0] or 0), ","), format(int(r[0][1] or 0), ","), _label(p)) if r else "No data found.")


def _sample_track(Q, org, q, bill):
    if re.search(r"\breject|recollect|why was|not accepted|insufficient|hemoly", q):
        if bill:
            if not _owned(Q, org, bill):
                return _out("sample", "I could not find bill **%s** on your account." % bill)
            rows = Q("SELECT TOP 20 a.INVCODE, a.SAMPLETYPE, a.REASON, a.REMARKS, a.ACKDATE, ISNULL(m.INVNAME,a.INVCODE), r.REJECTDESC FROM trnSampleLogisAcknow a "
                     "LEFT JOIN mstInvestigations m ON m.INVCODE COLLATE DATABASE_DEFAULT = a.INVCODE COLLATE DATABASE_DEFAULT "
                     "LEFT JOIN mstRejectReason r ON r.REJECTID COLLATE DATABASE_DEFAULT = a.REASON COLLATE DATABASE_DEFAULT WHERE a.BILLNO = ?", (bill,))
            rej = [r for r in rows if (r[2] and str(r[2]).strip()) or (r[3] and str(r[3]).strip())]
            if not rej:
                return _out("sample", "No sample rejection is recorded for bill **%s**." % bill, suggestions=["Raise recollection request"])
            return _out("sample", "Rejection / remark recorded for bill **%s**:" % bill,
                        _tbl("Sample rejection", ["Test", "Sample", "Reason", "Remarks", "Date"], [[r[5], r[1] or "", (r[6] or r[2] or ""), r[3] or "", _d(r[4])] for r in rej]),
                        suggestions=["Raise recollection request"])
        rows = Q("SELECT TOP 10 a.BILLNO, ISNULL(m.INVNAME,a.INVCODE), a.REASON, a.ACKDATE FROM trnSampleLogisAcknow a "
                 "JOIN trnINVLABPRI p ON p.BILLNO = a.BILLNO LEFT JOIN mstInvestigations m ON m.INVCODE COLLATE DATABASE_DEFAULT = a.INVCODE COLLATE DATABASE_DEFAULT "
                 "WHERE p.ORGANISATIONCODE = ? AND a.REASON IS NOT NULL AND LTRIM(RTRIM(a.REASON)) <> '' ORDER BY a.ACKDATE DESC", (org,))
        if not rows:
            return _out("sample", "I found no rejected samples for your organisation recently. Share a bill number to check a specific one.")
        return _out("sample", "Recent sample rejections for your organisation:", _tbl("Sample rejections", ["Bill", "Test", "Reason", "Date"], [[r[0], r[1], r[2], _d(r[3])] for r in rows]))
    if not bill:
        return _out("sample", "Please give the bill number, for example: \"Has the sample for bill ABC12345 reached the lab?\"")
    if not _owned(Q, org, bill):
        return _out("sample", "I could not find bill **%s** on your account." % bill)
    rows = Q("SELECT TOP 20 ISNULL(m.INVNAME,s.TCODE), s.SAMPLECOLLECTEDDATE, s.ACKNOWLEDGEDDATE, s.STATUS FROM trnInvStatus s "
             "LEFT JOIN mstInvestigations m ON m.INVCODE COLLATE DATABASE_DEFAULT = s.TCODE COLLATE DATABASE_DEFAULT WHERE s.BILLNO = ?", (bill,))
    if not rows:
        return _out("sample", "No sample movement is recorded yet for bill **%s**." % bill)
    reached = sum(1 for r in rows if r[2])
    return _out("sample", "Bill **%s**: %d of %d samples have reached the laboratory." % (bill, reached, len(rows)),
                _tbl("Sample tracking", ["Test", "Collected", "Received at lab", "Status"], [[r[0], _d(r[1]), _d(r[2]) or "Not yet", r[3] or ""] for r in rows]))


# ----------------------------------------------------------------------------------------------- router
_NO_PDF = re.compile(r"\breport pdf\b|\bdownload excel\b|\bexcel\b")


def route(Q: Callable, inst, contact, org_name, message, body_period="this_month", ticket_ok=True):
    """Pure routing (Q(sql, params) -> rows is injected, so it can be tested without a database)."""
    q = re.sub(r"\s+", " ", (message or "").lower()).strip()
    if not q or _NO_PDF.search(q):
        return None
    org = str(contact.get("organisation_code"))
    p = _period(q, body_period if body_period in ("today", "yesterday", "last_7_days", "this_month", "last_month") else "this_month")
    bill = _bill_no(message)

    try:        # operational analytics (pending / delayed / rejection / top tests / branch / trend / TAT / invoices)
        from auth.b2b_assist2 import route2
        _r2 = route2(Q, org, q, p, bill)
        if _r2 is not None:
            return _r2
    except ImportError:
        pass

    # information first when the question is clearly a lookup
    if re.search(r"\b(contract|agreement|validity|valid till|renewal date|client code|account status|agreed discount|discount|rate contract)\b", q) and not re.search(r"\brenew(al)? request|raise\b", q):
        return _contract(Q, org)
    if re.search(r"\b(outstanding|balance|credit limit|credit period|available credit|credit (is )?available|how much credit|payment|paid|received|statement|reconcil|ledger|tds|credit note|debit note|credit adjustment|pending (amount|payment|against)|how much (do we owe|is pending|is due)|dues?)\b", q) \
            and not re.search(r"\b(report|sample|test|result)s?\b.*\b(pending|ready)\b", q):
        return _account_answer(Q, org, q, p)
    if re.search(r"\b(sample|samples|specimen|vial|barcode)\b", q) and re.search(r"\b(reach|reached|receiv|arriv|track|where|status|collected|dispatch|reject|recollect|why was)\w*", q):
        return _sample_track(Q, org, q, bill)
    if re.search(r"\b(included|includes|include|contains?|inside|components?|what.s in)\b", q) and re.search(r"\b(profile|package|panel|checkup|check-up)\b", q):
        return _package_contents(Q, org, q)
    if re.search(r"\b(packages?|health[- ]?checks?|checkups?|corporate packages)\b", q) and re.search(r"\b(what|which|list|available|show|offer)\b", q):
        return _package_list(Q, org)
    if bill and re.search(r"\b(status|ready|where|track|progress|update)\b", q) and not re.search(r"\b(sample|reject)", q):
        return _status_for_bill(Q, org, bill)
    if re.search(r"\bwhen will\b.*\bready\b", q) and not bill:
        return _test_answer(Q, org, q, "info")
    if re.search(r"\b(status|ready|pending|completed|done|processed|authenticated|released)\b", q) and re.search(r"\b(report|reports|test|tests|result|results|sample)\b", q) \
            and not re.search(r"in-?house|outsourc", q):
        if re.search(r"\b(how many tests|tests (done|processed)|test volume|volume)\b", q):
            return _tests_volume(Q, org, p)
        return _status_for_bill(Q, org, bill) if bill else _status_for_period(Q, org, p)
    if re.search(r"\b(how many tests|tests (done|processed|performed)|test volume|monthly test|daily test|mis\b)", q):
        return _tests_volume(Q, org, p)

    t = classify_ticket(message)
    if t and ticket_ok:
        cat, pri, reply = t
        no, err = create_ticket(inst, contact, org_name, cat, pri, message, bill)
        if err:
            return _out("ticket", err)
        return _out("ticket", "%s Your ticket number is **%s** (%s priority). Our team will contact you on your registered number%s." %
                    (reply, no, pri.lower(), (" about bill " + bill) if bill else ""), ticket=no)

    if re.search(r"\b(available|availability|test code|code for|tat|turnaround|how long|when will .*ready|fasting|prepar|sample type|in-?house|outsourc|price|rate|cost|charges?)\b", q) \
            or re.search(r"\b(is|are) .{1,60}(available|offered|done|processed)\b", q):
        return _test_answer(Q, org, q, "avail" if re.search(r"\bavailab|offered\b", q) else "info")
    return None


def try_answer(inst, contact, message, period="this_month"):
    """Called by the B2B chat endpoint after authentication. Returns a response dict or None."""
    from auth.b2b_portal import _lis, _org_name

    def Q(sql, params=()):
        conn = _lis(inst)
        try:
            cur = conn.execute(sql, params)
            return cur.fetchall()
        finally:
            try:
                conn.close()
            except Exception:
                pass
    try:
        name = None
        try:
            name = _org_name(inst, contact.get("organisation_code"))
        except Exception:
            pass
        return route(Q, inst, contact, name, message, period)
    except Exception as e:
        try:
            from fastapi import HTTPException
            if isinstance(e, HTTPException):
                raise
        except ImportError:
            pass
        print("[b2b assist] fell back:", type(e).__name__, str(e)[:200], flush=True)
        return None
