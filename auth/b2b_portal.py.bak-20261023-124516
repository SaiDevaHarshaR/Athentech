    @router.get("/public/b2b/download-excel")
    def download_excel(request: Request, client: str = Query(..., min_length=1, max_length=50), period: str = "this_month"):
        inst, contact = _auth_session(request, client)
        rows = _rows_for_org(inst, contact["organisation_code"], period, max_rows=5000)
        if len(rows) > 5000:
            raise HTTPException(413, "This report exceeds 5,000 bills. Use a narrower date range.")
        from openpyxl import Workbook
        from openpyxl.styles import Alignment, Font, PatternFill
        from openpyxl.utils import get_column_letter
        wb = Workbook()
        ws = wb.active
        ws.title = "B2B Organisation Bills"
        ws.append(["B2B Billing Report", contact["organisation_code"], period])
        ws.append(["Invoice No", "Bill Date", "Billed Amount (INR)", "Bill Status"])
        def safe(v):
            s = str(v)
            return "'" + s if s[:1] in ("=", "+", "-", "@") else s
        for b, dt, amount, status in rows:
            ws.append([safe(b), dt, amount, safe(status)])
        for cell in ws[2]:
            cell.font = Font(bold=True, color="FFFFFF")
            cell.fill = PatternFill("solid", fgColor="243B53")
        for i, width in enumerate((24, 24, 25, 25), 1):
            ws.column_dimensions[get_column_letter(i)].width = width
        ws.freeze_panes = "A3"
        ws.auto_filter.ref = f"A2:D{max(2, ws.max_row)}"
        output = io.BytesIO()
        wb.save(output)
        output.seek(0)
        filename = "b2b_bills_" + re.sub(r"[^a-zA-Z0-9_-]", "_", period) + ".xlsx"
        return StreamingResponse(output,
            media_type="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            headers={"Content-Disposition": f'attachment; filename="{filename}"',
                     "Cache-Control": "private, no-store", "X-Content-Type-Options": "nosniff"})

    @router.post("/public/b2b/chat")
    def business_chat(body: ChatRequest, request: Request):
        _lang = None
        try:        # understand + reply in the user's Indian language
            from agent import lang_out as _lo
            from agent import lang_bridge as _lb
            _lang = _lo.detect(body.message)
            if not _lang and _lo.looks_roman(body.message):
                _r = _lo.classify_roman(body.message, str(body.client or "").upper())
                if _r:
                    _lang = (_r[0], _r[1], "roman")
                    body.message = _r[2]
            if _lang and len(_lang) == 2:
                _en = _lo.to_english(body.message, str(body.client or "").upper())
                if not _en:
                    _en, _ch = _lb.translate(body.message)
                    _en = _en if _ch else None
                if _en:
                    body.message = _en
        except Exception:
            _lang = None
        _res = _business_chat_core(body, request)
        if _lang and isinstance(_res, dict):
            try:
                _res = _lo.localize(_res, _lang, str(body.client or "").upper())
            except Exception:
                pass
        return _res

    def _business_chat_core(body: ChatRequest, request: Request):
        inst, contact = _auth_session(request, body.client)
        _rate("chat", request.client.host if request.client else "unknown", inst["id"],
              str(contact["id"]), 90, 600)
        try:        # portal how-to (password, letterhead, downloads, indent, contact): fixed text, no data
            from auth.b2b_help import b2b_help as _help
            _h = _help(body.message, str(inst.get("client_prefix") or body.client))
            if _h:
                return {"status": "success", "intent": "help", "answer": _h}
        except Exception as _e:
            print("[b2b help] skipped:", type(_e).__name__, flush=True)
        # Stage 12: retain authenticated, organization-scoped B2B routing.
        # Never use AI-generated SQL or trust a model for authorization.
        from auth.b2b_intent_engine import parse_question
        decision = parse_question(body.message)
        # Legacy explicit-scope denial has additional English phrases (such as
        # "all patients") that must be preserved when adopting Stage 7B.
        if _classify_business_question(body.message) == "forbidden":
            return {"status": "success", "intent": "forbidden", "answer":
                    "I can only access your verified organization's records."}
        if decision.intent != "forbidden":
            try:        # org-scoped lookups + support tickets (auth/b2b_assist.py); None = not one of its questions
                from auth.b2b_assist import try_answer as _assist
                _ans = _assist(inst, contact, body.message, body.period, body.chat_history)
                if _ans is not None:
                    return _ans
            except HTTPException:
                raise
            except Exception as _e:
                print("[b2b assist] skipped:", type(_e).__name__, flush=True)
        if decision.intent == "forbidden":
            intent = "forbidden"
        elif decision.intent == "patient_report":
            intent = "patient_report"
        elif decision.intent == "excel":
            intent = "excel"
        elif decision.intent == "overview":
            intent = "overview"
        elif decision.intent == "bills":
            intent = "bills"
        elif decision.intent in ("invoice_status", "unsupported_clinical_status", "clarify"):
            # Do not silently return ALL invoices for a pending/completed filter.
            _l = _llm_try(inst, contact, body)
            if _l is not None:
                return _l
            return {"status":"success", "intent":"status_mapping_required", "answer":
                    "Pending/completed status queries require approved LIS-specific status mapping. No unfiltered records were returned."}
        else:
            # Only ambiguous authenticated requests may be interpreted by local
            # Qwen3. The model can select a safe intent, never a SQL query.
            from auth.b2b_local_intent import refine_ambiguous
            intent = refine_ambiguous(body.message, str(inst.get("client_prefix") or body.client))
        org = contact["organisation_code"]  # always resolved server-side
        requested_period = decision.period or body.period
        if intent == "forbidden":
            return {"status": "success", "intent": intent, "answer": "I can only access your verified organization's records."}
        if intent == "patient_report":
            return {"status": "success", "intent": intent,
                    "answer": "To download a patient PDF, type: Report PDF BILLNUMBER. The invoice must belong to your organization, and an approved report must be available."}
        if intent == "excel":
            return {"status": "success", "intent": intent, "action": "download_excel", "period": requested_period,
                    "answer": "Your organization's Excel invoice report is ready to request."}
        if intent in ("overview", "bills"):
            try:
                _period_dates(requested_period)
            except HTTPException:
                requested_period = body.period if body.period else "this_month"  # unparseable phrase -> selected period
            try:
                if intent == "overview":
                    summary = _summary_for_org(inst, org, requested_period)
                    label = summary.get("period_label") or requested_period
                    text = (f"For {label}: {summary.get('bills', 0)} invoice{'s' if summary.get('bills', 0) != 1 else ''}, "
                            f"billed amount INR {summary.get('billed_total', 0):,.2f}. "
                            "This is billed value, not collected cash.")
                    if summary.get("bills") == 0:
                        text = f"No invoices were found for your organization in {label}."
                    elif summary.get("invoice_statuses"):
                        text += " By status: " + ", ".join(
                            f"{x['status']} {x['bills']}" for x in summary["invoice_statuses"][:6]) + "."
                    return {"status": "success", "intent": intent, "summary": summary, "answer": text}
                rows = _rows_for_org(inst, org, requested_period, max_rows=20)
                s_, e_ = _period_dates(requested_period)
                label = _period_label(requested_period, s_, e_)
                shown = min(len(rows), 20)
                if not rows:
                    text = f"No invoices were found for your organization in {label}."
                elif len(rows) > 20:
                    text = f"Showing the latest {shown} invoices for {label}. More exist: download the Excel report for the full list."
                else:
                    text = f"Found {shown} invoice{'s' if shown != 1 else ''} for your organization in {label}."
                return {"status": "success", "intent": intent,
                        "bills": [{"bill_no": b, "bill_date": dt, "billed_amount": amount, "status": st}
                                  for b, dt, amount, st in rows[:20]], "has_more": len(rows) > 20, "answer": text}
            except HTTPException as exc:
                if exc.status_code in (400, 422, 503):  # schema / config problem: say so instead of a bare error
                    return {"status": "success", "intent": intent, "answer": str(exc.detail)}
                raise
            except Exception:
                return {"status": "success", "intent": intent,
                        "answer": "I couldn't read your organization's records just now. Please try again in a minute."}
        # FAQ is separate from financial tools. The backend supplies the
        # authenticated institution and organization, never an LLM-supplied ID.
        if intent == "help":
            from auth.b2b_local_answer import approved_faq_answer
            faq_answer = approved_faq_answer(question=body.message, inst=inst,
                                             organization_code=org)
            if faq_answer:
                return {"status":"success", "intent":"approved_faq", "answer":faq_answer}
        _l2 = _llm_try(inst, contact, body)
        if _l2 is not None:
            return _l2
        return {"status": "success", "intent": intent,
                "answer": "You can ask: How many invoices this month? Show pending invoices. "
                          "What is our billed amount? Download Excel. Report PDF BILLNUMBER. "
                          "Choose a reporting period to change the date range."}

