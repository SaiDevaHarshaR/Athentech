        return None


def _classify_business_question(question):
    """Deterministic natural-language routing, including report requests."""
    q = re.sub(r"\s+", " ", question.strip().lower())
    if re.search(r"\b(other company|another company|all organizations|all organisations|all patients)\b", q):
        return "forbidden"
    if re.search(r"\b(pdf|patient report|lab report|test report|download report)\b", q):
        return "patient_report"
    if re.search(r"\b(download|export|excel|spreadsheet|xlsx)\b", q):
        return "excel"
    if re.search(r"\b(how many|total|count|number of)\b", q) and re.search(r"\b(bills?|invoices?|samples?|investigations?)\b", q):
        return "overview"
    if re.search(r"\b(pending|status|statuses|invoice|invoices|bill|bills|completed report)\b", q):
        return "bills"
    if re.search(r"\b(how many|total|overview|summary|amount|business|dashboard|revenue|collection|investigation|sample)\b", q):
        return "overview"
    return "help"


def _pdf_configured_root(inst):
    """Trusted server-admin config only; no user-provided path, and disabled by default.

    JSON example: {"KONNECT": "/srv/sahasra-approved-pdfs/konnect"}.
    Only pre-approved exported LIS PDFs named by safe bill number are served.
    """
    from pathlib import Path
    try:
        roots = json.loads(os.environ.get("B2B_PDF_EXPORT_ROOTS", "{}"))
        root = roots.get(str(inst.get("client_prefix", "")).upper())
        if not isinstance(root, str) or not root:
            return None
        resolved = Path(root).resolve(strict=True)
        return resolved if resolved.is_dir() else None
    except (ValueError, OSError, TypeError):
        return None


def _authorized_pdf(inst, org_code, bill_no):
    from pathlib import Path
    if not re.fullmatch(r"[A-Za-z0-9_-]{1,60}", bill_no or ""):
        raise HTTPException(400, "Enter an invoice number using letters, numbers, hyphens or underscores.")
    # Authorization MUST precede any filesystem access. The bill is NOT trusted from the browser.
    conn = _lis(inst)
    try:
        match = conn.execute(
            "SELECT TOP 1 BILLNO FROM trnINVLABPRI WHERE BILLNO=? AND ORGANISATIONCODE=?",
            (bill_no, org_code),
        ).fetchone()
        if match is None:
            raise HTTPException(404, "No authorized report found for this invoice.")
    finally:
        conn.close()
    root = _pdf_configured_root(inst)
    target = (root / (bill_no + ".pdf")).resolve() if root is not None else None
    if target is None or target.parent != root or not target.is_file() or target.is_symlink():
        # no exported signed report: give a clean, clearly-labelled status summary built from the client's own bill
        try:
            from auth.b2b_pdf import build_summary_pdf
            from auth.whitelabel import get_config
            cfg = get_config(int(inst["id"]))
            conn2 = _lis(inst)
            try:
                return build_summary_pdf(conn2, org_code, bill_no, cfg.get("brand_name") or inst.get("name") or "Laboratory", cfg.get("primary_color") or "#F26B21")
            finally:
                conn2.close()
        except HTTPException:
            raise
        except Exception as _e:
            print("[b2b pdf] summary failed:", type(_e).__name__, str(_e)[:160], flush=True)
            raise HTTPException(503, "The report PDF could not be prepared right now.")
    if target.stat().st_size > 25 * 1024 * 1024:
        raise HTTPException(413, "PDF exceeds the allowed size.")
    with target.open("rb") as handle:
        pdf = handle.read()
    if not pdf.startswith(b"%PDF-"):
        raise HTTPException(422, "The approved report export is not a valid PDF.")
    return pdf


def build_router(require_admin) -> APIRouter:
    router = APIRouter()

    @router.get("/admin/b2b/contacts")
    def contacts(institution_id: int = Query(..., gt=0), admin: str = Depends(require_admin)):
        if not _institution_by_id(institution_id): raise HTTPException(404, "Institution not found")
        conn = _admin_conn()
        try:
            rows = conn.execute("SELECT id, organisation_code, contact_name, phone_e164, active "
                                "FROM dbo.sahasra_b2b_contacts WHERE institution_id=? ORDER BY organisation_code, contact_name",
                                (institution_id,)).fetchall()
            return {"contacts": [{"id": r[0] if not hasattr(r, "items") else r["id"],
                      "organisation_code": r[1] if not hasattr(r, "items") else r["organisation_code"],
                      "contact_name": r[2] if not hasattr(r, "items") else r["contact_name"],
                      "phone": r[3] if not hasattr(r, "items") else r["phone_e164"],
                      "active": bool(r[4] if not hasattr(r, "items") else r["active"])} for r in rows]}
        finally: conn.close()

    @router.post("/admin/b2b/contacts")
    def create_contact(body: ContactIn, admin: str = Depends(require_admin)):
        inst = _institution_by_id(body.institution_id)
        if not inst: raise HTTPException(404, "Institution not found")
        code = body.organisation_code.strip().upper()
        if not re.fullmatch(r"[A-Za-z0-9_.-]{1,80}", code):
            raise HTTPException(400, "Invalid organisation code.")
        company = _org_name(inst, code)  # Admin cannot grant an invented organisation.
        if not company: raise HTTPException(422, "Organisation code does not exist in this client's LIS database.")
        phone = _phone(body.phone)
        conn = _admin_conn()
        try:
            conn.execute("INSERT INTO dbo.sahasra_b2b_contacts "
                         "(institution_id, organisation_code, contact_name, phone_e164, created_by) "
                         "VALUES (?,?,?,?,?)", (body.institution_id, code, body.contact_name.strip(), phone, admin))
            conn.commit()
        except Exception:
            try: conn.rollback()
            except Exception: pass
            raise HTTPException(409, "Phone is already registered for this institution or contact could not be saved.")
        finally: conn.close()
        return {"status": "success", "organisation": company, "phone": phone}

    @router.post("/admin/b2b/contacts/{contact_id}/access")
    def change_access(contact_id: int, institution_id: int = Query(..., gt=0), active: bool = Query(...),
                      admin: str = Depends(require_admin)):
        conn = _admin_conn()
        try:
            cur = conn.cursor()
            cur.execute("UPDATE dbo.sahasra_b2b_contacts SET active=? WHERE id=? AND institution_id=?",
                        (int(active), contact_id, institution_id))
            if cur.rowcount != 1: raise HTTPException(404, "Contact not found")
            if not active:
                cur.execute("UPDATE dbo.sahasra_b2b_sessions SET revoked=1 WHERE contact_id=? AND institution_id=?",
                            (contact_id, institution_id))
            conn.commit()
        except Exception:
            try: conn.rollback()
            except Exception: pass
            raise
        finally: conn.close()
        return {"status": "success", "active": active}

    @router.get("/admin/b2b/test-otp")
    def inspect_test_otp(institution_id: int = Query(..., gt=0),
                         contact_id: int = Query(..., gt=0), admin: str = Depends(require_admin)):
        """Admin-only staging diagnostics: retrieve OTP for a registered active contact."""
        if _otp_delivery() != "test":
            raise HTTPException(404, "Test OTP is not enabled.")
        conn = _admin_conn()
        try:
            row = conn.execute("SELECT TOP 1 o.encrypted_code, o.expires_at "
                               "FROM dbo.sahasra_b2b_test_otp o "
                               "JOIN dbo.sahasra_b2b_contacts c ON c.id=o.contact_id "
                               "AND c.institution_id=o.institution_id "
                               "WHERE o.institution_id=? AND o.contact_id=? "
                               "AND c.active=1 AND o.consumed=0 AND o.attempts<5 "
                               "AND o.expires_at>SYSUTCDATETIME()",
                               (institution_id, contact_id)).fetchone()
            if not row: raise HTTPException(404, "No active test code for this contact.")
            encrypted = row["encrypted_code"] if hasattr(row, "items") else row[0]
            return {"test_code": decrypt_secret(encrypted), "expires_in_minutes": 5,
                    "warning": "TEST ENVIRONMENT ONLY. Never send this code to production users."}
        finally: conn.close()

    @router.post("/public/b2b/request-otp")
    def request_otp(body: OTPRequest, request: Request):
        inst = _institution_by_prefix(body.client)
        if not _b2b_enabled(inst): raise HTTPException(404, "This B2B portal is not available.")
        phone = _phone(body.phone)
        ip = request.client.host if request.client else "unknown"
        _rate("start-ip", ip, inst["id"], "ip", 15)
        _rate("start-phone", "global", inst["id"], phone, 3)
        mode = "test" if _testreg() else _otp_delivery()
        _tc = None
        contact = _contact(int(inst["id"]), phone)
        # Same response for unknown numbers: no phone / organization enumeration.
        if contact:
            if mode == "test":
                _tc = _make_test_otp(int(inst["id"]), int(contact["id"]))
            else:
                response = _twilio("Verifications", {"To": phone, "Channel": "sms"})
                if response.get("status") not in ("pending", "approved"):
                    raise HTTPException(502, "SMS provider did not accept the verification request.")
        note = ("If registered, a test verification code is available to an authorized staging admin."
                if mode == "test" else "If this number is registered, a verification SMS has been sent.")
        if _tc and _testreg():
            return {"status": "success", "message": note, "test_code": _tc}
        return {"status": "success", "message": note}

    @router.post("/public/b2b/verify-otp")
    def verify_otp(body: OTPCheck, request: Request):
        inst = _institution_by_prefix(body.client)
        if not _b2b_enabled(inst): raise HTTPException(404, "This B2B portal is not available.")
        phone = _phone(body.phone)
        if not re.fullmatch(r"\d{4,10}", body.code): raise HTTPException(400, "Enter the numeric verification code.")
        ip = request.client.host if request.client else "unknown"
        _rate("verify-ip", ip, inst["id"], "ip", 30)
        _rate("verify-phone", "global", inst["id"], phone, 8)
        contact = _contact(int(inst["id"]), phone)
        if not contact: raise HTTPException(401, "Invalid or expired verification code.")
        mode = "test" if _testreg() else _otp_delivery()
        if mode == "test":
            verified = _verify_test_otp(int(inst["id"]), int(contact["id"]), body.code)
        else:
            response = _twilio("VerificationCheck", {"To": phone, "Code": body.code})
            verified = hmac.compare_digest(str(response.get("status", "")), "approved")
        if not verified:
            raise HTTPException(401, "Invalid or expired verification code.")
        token = secrets.token_urlsafe(48)
        expiry = _utc() + timedelta(hours=SESSION_HOURS)
        conn = _admin_conn()
        try:
            conn.execute("INSERT INTO dbo.sahasra_b2b_sessions "
                         "(token_hash, contact_id, institution_id, expires_at) VALUES (?,?,?,?)",
                         (hashlib.sha256(token.encode()).hexdigest(), contact["id"], inst["id"], expiry))
            conn.commit()
        finally: conn.close()
        return {"status": "success", "access_token": token, "expires_in": SESSION_HOURS * 3600,
                "contact_name": contact["contact_name"], "organisation": contact["organisation_code"],
                "organisation_name": _org_name_safe(inst, contact["organisation_code"])}

