def _weak_name(message):
    """A name-like word in a question without explicit patient words: capitalised (not the first word) or possessive."""
    words = re.findall(r"[A-Za-z][A-Za-z.\-']*", message)
    left = [w for w in re.findall(r"[A-Za-z][A-Za-z.\-]{2,}", message) if w.lower().strip(".-") not in _NAME_STOP]
    if not left:
        return False
    if re.search(r"[A-Za-z]['\u2019]s\b", message):
        return True
    for i, w in enumerate(words):
        core = w.strip(".-'")
        if i > 0 and w[0].isupper() and core.lower() in [x.lower() for x in left] and not (core.isupper() and len(core) <= 4):
            return True       # acronyms such as GST / API / CBC / TAT are not names
    return False


def _recent_bills(Q, org, q):
