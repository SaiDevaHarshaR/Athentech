def _admin():
    from database.license_db import get_conn
    return get_conn()


def _ensure():
    global _ready
    if _ready:
        return
    c = _admin()
    try:
        cur = c.cursor()
        cur.execute(_DDL)
        c.commit()
        _ready = True
    finally:
        c.close()


def classify_ticket(msg: str):
    q = (msg or "").lower()
    for cat, pri, rx, reply in _TICKET_RULES:
        if re.search(rx, q):
            return cat, pri, reply
    return None


def create_ticket(inst, contact, org_name, category, priority, message, bill_no=None):
    """-> (ticket_no | None, error message | None)."""
    try:
        _ensure()
        c = _admin()
        try:
            n = c.execute("SELECT COUNT(*) FROM dbo.sahasra_b2b_tickets WHERE contact_id=? AND created_at > DATEADD(hour,-24,SYSUTCDATETIME())",
                          (contact.get("id"),)).fetchone()[0]
            if int(n or 0) >= _DAILY_LIMIT:
                return None, "You have reached today's limit for support requests. Please call us directly."
            no = "TKT-%s-%s" % (time.strftime("%y%m%d"), "".join(secrets.choice("0123456789") for _ in range(4)))
            c.execute("INSERT INTO dbo.sahasra_b2b_tickets (ticket_no, institution_id, contact_id, organisation_code, organisation_name, contact_name, phone, "
                      "category, priority, details, bill_no) VALUES (?,?,?,?,?,?,?,?,?,?,?)",
                      (no, int(inst["id"]), contact.get("id"), str(contact.get("organisation_code")), (org_name or "")[:200],
                       str(contact.get("contact_name") or "")[:120], str(contact.get("phone_e164") or "")[:30], category, priority,
                       (message or "")[:1000], bill_no))
            c.commit()
            print("[b2b ticket] %s %s org=%s" % (no, category, contact.get("organisation_code")), flush=True)
            return no, None
        finally:
            c.close()
    except Exception as e:
        print("[b2b ticket] failed:", type(e).__name__, str(e)[:160], flush=True)
        return None, "I could not register that right now. Please try again in a few minutes or call us."


def list_tickets(status: str = "", limit: int = 200):
    _ensure()
    c = _admin()
    try:
        sql = ("SELECT TOP %d ticket_no, organisation_code, organisation_name, contact_name, phone, category, priority, details, bill_no, status, note, created_at "
               "FROM dbo.sahasra_b2b_tickets" % max(1, min(int(limit), 500)))
        args = ()
        if status:
            sql += " WHERE status = ?"
            args = (status,)
        rows = c.execute(sql + " ORDER BY id DESC", args).fetchall()
        keys = ["ticket_no", "organisation_code", "organisation_name", "contact_name", "phone", "category", "priority", "details", "bill_no", "status", "note", "created_at"]
        return [{k: (str(r[i]) if k == "created_at" and r[i] is not None else r[i]) for i, k in enumerate(keys)} for r in rows]
    finally:
        c.close()


def set_ticket_status(ticket_no: str, status: str, note: str, admin: str):
    if status not in ("Open", "In progress", "Resolved", "Closed"):
        raise ValueError("Status must be Open, In progress, Resolved or Closed.")
    _ensure()
    c = _admin()
    try:
        c.execute("UPDATE dbo.sahasra_b2b_tickets SET status=?, note=?, updated_at=SYSUTCDATETIME(), updated_by=? WHERE ticket_no=?",
                  (status, (note or "")[:500], (admin or "")[:100], ticket_no))
        c.commit()
    finally:
        c.close()


