# ----------------------------------------------------------------------------------------------- helpers
_PERIODS = (("last 7 days", "last_7_days"), ("last seven days", "last_7_days"), ("this week", "last_7_days"), ("last month", "last_month"),
            ("previous month", "last_month"), ("this month", "this_month"), ("yesterday", "yesterday"), ("today", "today"))


def _inr(v) -> str:
    try:
        x = float(v or 0)
    except Exception:
        return "\u20b9" + str(v)
    neg = x < 0
    x = abs(x)
    whole, frac = divmod(round(x * 100), 100)
    s = str(int(whole))
    if len(s) > 3:
        head, tail = s[:-3], s[-3:]
        parts = []
        while len(head) > 2:
            parts.insert(0, head[-2:])
            head = head[:-2]
        if head:
            parts.insert(0, head)
        s = ",".join(parts) + "," + tail
    return ("-" if neg else "") + "\u20b9" + s + (".%02d" % frac if frac else "")


def _d(v) -> str:
    return str(v)[:10] if v else ""


def _period(q: str, default: str = "this_month") -> str:
    for k, v in _PERIODS:
        if k in q:
            return v
    m = re.search(r"\b(20\d{2}-\d{2}(?:-\d{2})?)\b", q)
    return m.group(1) if m else default


def _dates(p: str):
    t = date.today()
    if p == "today":
        a, b = t, t + timedelta(days=1)
    elif p == "yesterday":
        a, b = t - timedelta(days=1), t
    elif p == "last_7_days":
        a, b = t - timedelta(days=6), t + timedelta(days=1)
    elif p == "last_month":
        b = t.replace(day=1)
        a = (b - timedelta(days=1)).replace(day=1)
    elif re.fullmatch(r"20\d{2}-\d{2}-\d{2}", p):
        a = date.fromisoformat(p)
        b = a + timedelta(days=1)
    elif re.fullmatch(r"20\d{2}-\d{2}", p):
        a = date.fromisoformat(p + "-01")
        b = date(a.year + (a.month == 12), a.month % 12 + 1, 1)
    else:
        a, b = t.replace(day=1), t + timedelta(days=1)
    return a.isoformat(), b.isoformat()


_LABEL = {"today": "today", "yesterday": "yesterday", "last_7_days": "the last 7 days", "this_month": "this month", "last_month": "last month"}


def _label(p: str) -> str:
    return _LABEL.get(p, p)


_BILL_STOP = set("status number details report reports amount pending date copy statement payment payments generated total please there which where about "
                 "invoice invoices today yesterday month week sample samples ready completed delayed".split())


def _bill_no(msg: str) -> Optional[str]:
    m = re.search(r"(?:bill|invoice|barcode|accession|sample)\s*(?:no\.?|number|id|#)?\s*[:\-]?\s*([A-Za-z0-9][A-Za-z0-9\-/]{4,24})", msg, re.I)
    if m and re.search(r"\d", m.group(1)):
        return m.group(1).upper()
    if m and m.group(1).lower() not in _BILL_STOP and re.search(r"\b(bill|barcode)\s*(no\.?|number|id|#)?\s*[:\-]?\s*" + re.escape(m.group(1)), msg, re.I):
        return m.group(1).upper()      # an explicit "bill XXXXX" even without digits; ownership is checked later
    for t in re.findall(r"\b[A-Za-z0-9][A-Za-z0-9\-/]{5,24}\b", msg):
        if re.search(r"\d", t) and re.search(r"[A-Za-z]", t) and not re.fullmatch(r"20\d{2}-\d{2}(-\d{2})?", t) and not re.match(r"(?i)pkg\d+$", t):
            return t.upper()
    return None


def _out(intent, answer, table=None, suggestions=None, **extra):
    r = {"status": "success", "intent": intent, "answer": answer}
    if table:
        r["table"] = table
    if suggestions:
        r["suggestions"] = suggestions
    r.update(extra)
    return r


def _tbl(title, columns, rows):
    return {"title": title, "columns": columns, "rows": [[("" if c is None else str(c)) for c in r] for r in rows]}


